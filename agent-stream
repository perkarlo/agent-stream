# Ortak arayüz: sync(dirs, files) izlenecek kümeyi kurar, wait(timeout) bir şey
# olana kadar bloklar ve (uyandı mı, tarama gerekli mi) döner.

class PollWatcher:
    """Olay arayüzü olmayan sistemler için: uyur, tarama zamanlamasını çağırana bırakır."""

    name = "poll"

    def sync(self, dirs: Iterable[str], files: Iterable[str]) -> None:
        pass

    def wait(self, timeout: float) -> tuple[bool, bool]:
        time.sleep(timeout)
        return False, False

    def close(self) -> None:
        pass


class KqueueWatcher(PollWatcher):
    """macOS/BSD: dizinlerde oluşturma, dosyalarda ekleme olayları."""

    name = "kqueue"

    def __init__(self) -> None:
        import select
        self.select = select
        self.kq = select.kqueue()
        self.fds: dict[str, int] = {}
        self.dirs: set[int] = set()

    def sync(self, dirs, files) -> None:
        want = list(dirs)[:WATCH_CAP] + list(files)[:WATCH_CAP]
        wanted = set(want)
        for path in list(self.fds):
            if path not in wanted:
                os.close(self.fds.pop(path))
        add = []
        for path in want:
            if path in self.fds:
                continue
            try:
                fd = os.open(path, os.O_RDONLY)
            except OSError:
                continue
            self.fds[path] = fd
            if os.path.isdir(path):
                self.dirs.add(fd)
            flags = (self.select.KQ_NOTE_WRITE | self.select.KQ_NOTE_EXTEND
                     | self.select.KQ_NOTE_DELETE | self.select.KQ_NOTE_RENAME)
            add.append(self.select.kevent(fd, filter=self.select.KQ_FILTER_VNODE,
                                          flags=self.select.KQ_EV_ADD | self.select.KQ_EV_CLEAR,
                                          fflags=flags))
        if add:
            self.kq.control(add, 0, 0)

    def wait(self, timeout: float) -> tuple[bool, bool]:
        try:
            got = self.kq.control(None, 64, timeout)
        except OSError:
            return False, True
        rescan = any(e.ident in self.dirs or e.fflags & (self.select.KQ_NOTE_DELETE
                                                         | self.select.KQ_NOTE_RENAME) for e in got)
        return bool(got), rescan

    def close(self) -> None:
        for fd in self.fds.values():
            try:
                os.close(fd)
            except OSError:
                pass
        self.fds.clear()
        self.kq.close()


class InotifyWatcher(PollWatcher):
    """Linux: dizin izlemek yeterli — içindeki dosyaların olayları da adıyla gelir."""

    name = "inotify"
    IN_MODIFY, IN_ATTRIB, IN_CREATE = 0x00000002, 0x00000004, 0x00000100
    IN_MOVED_TO, IN_DELETE, IN_MOVE_SELF = 0x00000080, 0x00000200, 0x00000800
    O_NONBLOCK = 0o4000

    def __init__(self) -> None:
        import ctypes
        import select
        import struct
        self.struct, self.select = struct, select
        self.libc = ctypes.CDLL("libc.so.6", use_errno=True)
        self.fd = self.libc.inotify_init1(self.O_NONBLOCK)
        if self.fd < 0:
            raise OSError("inotify_init1 başarısız")
        self.wds: dict[str, int] = {}

    def sync(self, dirs, files) -> None:
        want = set(list(dirs)[:WATCH_CAP])                 # dosyalar dizinleriyle kapsanıyor
        for path, wd in list(self.wds.items()):
            if path not in want:
                self.libc.inotify_rm_watch(self.fd, wd)
                self.wds.pop(path, None)
        mask = (self.IN_MODIFY | self.IN_ATTRIB | self.IN_CREATE
                | self.IN_MOVED_TO | self.IN_DELETE | self.IN_MOVE_SELF)
        for path in want:
            if path in self.wds:
                continue
            wd = self.libc.inotify_add_watch(self.fd, os.fsencode(path), mask)
            if wd >= 0:
                self.wds[path] = wd

    def _drain(self) -> tuple[bool, bool]:
        woke = rescan = False
        while True:
            try:
                buf = os.read(self.fd, 8192)
            except BlockingIOError:
                break
            except OSError:
                return woke, True
            if not buf:
                break
            woke = True
            i = 0
            while i + 16 <= len(buf):
                _wd, mask, _cookie, ln = self.struct.unpack_from("iIII", buf, i)
                i += 16 + ln
                if mask & (self.IN_CREATE | self.IN_MOVED_TO | self.IN_DELETE | self.IN_MOVE_SELF):
                    rescan = True
        return woke, rescan

    def wait(self, timeout: float) -> tuple[bool, bool]:
        ready, _, _ = self.select.select([self.fd], [], [], timeout)
        if not ready:
            return False, False
        return self._drain()

    def close(self) -> None:
        try:
            os.close(self.fd)
        except OSError:
            pass


def make_watcher() -> PollWatcher:
    """AGENT_STREAM_WATCH ile zorlanabilir; kurulamayan arka uç sessizce yoklamaya düşer."""
    want = os.environ.get("AGENT_STREAM_WATCH", "auto").lower()
    order = {"auto": ["kqueue", "inotify"], "kqueue": ["kqueue"],
             "inotify": ["inotify"], "poll": []}.get(want, ["kqueue", "inotify"])
    for name in order:
        try:
            return KqueueWatcher() if name == "kqueue" else InotifyWatcher()
        except Exception:
            continue
    return PollWatcher()


