app = typer.Typer(
    add_completion=False,
    no_args_is_help=False,
    context_settings={"help_option_names": ["-h", "--help"]},
    rich_markup_mode="rich",
)


def load_config() -> dict:
    if not CONFIG_PATH.exists():
        return {}
    try:
        with open(CONFIG_PATH, "rb") as fh:
            return tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError) as exc:
        err_console.print(f"[yellow]uyarı:[/] {CONFIG_PATH} okunamadı ({exc}); yok sayıldı", highlight=False)
        return {}


def cfg_value(ctx: typer.Context, cfg: dict, name: str, value):
    """Öncelik: bayrak > ortam değişkeni > ayar dosyası > varsayılan (clig.dev)."""
    src = ctx.get_parameter_source(name)
    if src is not None and src.name in ("COMMANDLINE", "ENVIRONMENT"):
        return value
    return cfg.get(name, value)


def setup_console(no_color: bool) -> Console:
    if no_color or os.environ.get("NO_COLOR") or os.environ.get("TERM") == "dumb":
        return Console(no_color=True, highlight=False, soft_wrap=False)
    return Console(highlight=False, soft_wrap=False)


def version_cb(value: bool):
    if value:
        out_console.print(f"agent-stream {VERSION}")
        raise typer.Exit()


@app.callback(invoke_without_command=True)
def stream(
    ctx: typer.Context,
    project: str = typer.Option(None, "-p", "--project", envvar="AGENT_STREAM_PROJECT",
                                help="proje/cwd filtresi (parça eşleşmesi)"),
    session: str = typer.Option(None, "-s", "--session", help="oturum etiketi öneki, örn. a3d1"),
    all_tools: bool = typer.Option(False, "-a", "--all-tools", help="sadece Bash değil, tüm araçlar"),
    quiet: bool = typer.Option(False, "-q", "--quiet", help="sadece komutlar, çıktı yok"),
    max_lines: int = typer.Option(12, "-n", "--max-lines", metavar="N", help="komut başına çıktı satırı sınırı"),
    max_cmd: int = typer.Option(10, "-m", "--max-cmd", metavar="N", help="komut bloğu satır sınırı (0 = sınırsız)"),
    backfill: int = typer.Option(0, "-b", "--backfill", metavar="N", help="açılışta son N komutu da göster"),
    stale: float = typer.Option(30, "--stale", metavar="DK", help="bu süredir sessiz oturumlar atlanır"),
    interval: float = typer.Option(0.25, "--interval", metavar="SN", help="yoklama aralığı"),
    subagents: bool = typer.Option(True, "--subagents/--no-subagents", help="subagent şeritlerini göster"),
    pair: bool = typer.Option(False, "--pair", help="komutu çıktısıyla birlikte, bittiğinde yaz"),
    desc: bool = typer.Option(True, "--desc/--no-desc", help="komut açıklamasını göster"),
    as_json: bool = typer.Option(False, "--json", help="satır satır JSON (NDJSON) yaz"),
    no_color: bool = typer.Option(False, "--no-color", help="rengi kapat (NO_COLOR da geçerli)"),
    root: Path = typer.Option(DEFAULT_ROOT, "--root", envvar="AGENT_STREAM_ROOT", help="transcript kökü"),
    version: bool = typer.Option(False, "-V", "--version", callback=version_cb, is_eager=True,
                                 help="sürümü yaz ve çık"),
):
    """
    Claude Code oturumlarının çalıştırdığı komutları canlı akıtır.

    [bold]Örnekler[/]
      agent-stream                       tüm aktif oturumların komut akışı
      agent-stream -p myapp -n 6         sadece myapp, komut başına 6 satır çıktı
      agent-stream --pair -q             komutu çıktısıyla birlikte, sade
      agent-stream dash                  paralel oturumlar için canlı pano
      agent-stream sessions              aktif oturumları listele
      agent-stream replay a3d1           geçmiş bir oturumu baştan oynat
      agent-stream --json | jq -r .command    akışı makineye ver

    Ayar dosyası: ~/.config/agent-stream/config.toml  ·  ortam: AGENT_STREAM_PROJECT, AGENT_STREAM_ROOT
    """
    if ctx.invoked_subcommand is not None:
        return
    raw = load_config()
    cfg = {**raw.get("genel", {}), **raw.get("stream", {})}
    max_lines = cfg_value(ctx, cfg, "max_lines", max_lines)
    max_cmd = cfg_value(ctx, cfg, "max_cmd", max_cmd)
    stale = cfg_value(ctx, cfg, "stale", stale)
    project = cfg_value(ctx, cfg, "project", project)

    if not root.is_dir():
        die(f"{root} yok", "Claude Code bu makinede hiç çalışmamış olabilir; --root ile başka bir kök verebilirsin.")

    console = setup_console(no_color)
    reader = Reader(root, project, session, all_tools, subagents, stale)
    view = StreamView(console, max_lines, desc, not quiet, max_cmd)

    if not as_json:
        scope = f"{project or 'tüm projeler'}"
        err_console.print(f"[dim]agent-stream {VERSION} · {scope} · çıkış Ctrl+C[/]", highlight=False)

    events = reader.poll(first=True, backfill=backfill)
    while True:
        for kind, cmd in events:
            if as_json:
                if kind == "end":
                    print(json.dumps(cmd.as_json(), ensure_ascii=False), flush=True)
            elif kind == "start":
                if not pair:
                    view.start(cmd)
            else:
                if pair:
                    view.start(cmd)
                view.end(cmd)
        time.sleep(interval)
        events = reader.poll()


@app.command()
def dash(
    project: str = typer.Option(None, "-p", "--project", envvar="AGENT_STREAM_PROJECT", help="proje/cwd filtresi"),
    session: str = typer.Option(None, "-s", "--session", help="oturum etiketi öneki"),
    all_tools: bool = typer.Option(False, "-a", "--all-tools", help="tüm araçlar"),
    lanes: int = typer.Option(4, "-c", "--columns", metavar="N", help="yan yana gösterilecek oturum sayısı"),
    stale: float = typer.Option(15, "--stale", metavar="DK", help="bu süredir sessiz oturumlar atlanır"),
    interval: float = typer.Option(0.2, "--interval", metavar="SN", help="yoklama aralığı"),
    root: Path = typer.Option(DEFAULT_ROOT, "--root", envvar="AGENT_STREAM_ROOT", help="transcript kökü"),
):
    """Paralel oturumları yan yana şeritlerde gösteren canlı pano."""
    if not root.is_dir():
        die(f"{root} yok", "--root ile transcript kökünü verebilirsin.")
    console = setup_console(False)
    if not console.is_terminal:
        die("pano bir terminal gerektirir", "boru hattında `agent-stream --json` kullan.", EXIT_USAGE)

    reader = Reader(root, project, session, all_tools, True, stale)
    lanes_by_sid: dict[str, Lane] = {}
    recent: list[Cmd] = []
    started, total = time.time(), 0

    reader.poll(first=True)
    with Live(console=console, screen=True, refresh_per_second=8, transient=True) as live:
        while True:
            for kind, cmd in reader.poll():
                lane = lanes_by_sid.setdefault(cmd.sid, Lane(cmd.sid))
                lane.cwd, lane.branch, lane.seen = cmd.cwd, cmd.branch, time.time()
                if kind == "start":
                    lane.running, total = cmd, total + 1
                else:
                    lane.running, lane.last, lane.count = None, cmd, lane.count + 1
                    recent.append(cmd)
                    recent[:] = recent[-20:]
            cutoff = time.time() - stale * 60
            for sid in [s for s, l in lanes_by_sid.items() if l.seen < cutoff]:
                del lanes_by_sid[sid]
            live.update(dash_frame(lanes_by_sid, recent, started, total, console, lanes))
            time.sleep(interval)


@app.command()
def sessions(
    stale: float = typer.Option(60, "--stale", metavar="DK", help="bu süredir sessiz oturumlar gizlenir"),
    all_: bool = typer.Option(False, "--all", help="süre filtresi olmadan hepsini listele"),
    as_json: bool = typer.Option(False, "--json", help="JSON yaz"),
    root: Path = typer.Option(DEFAULT_ROOT, "--root", envvar="AGENT_STREAM_ROOT", help="transcript kökü"),
):
    """Aktif (ve istenirse tüm) oturumları etiketleriyle listele."""
    if not root.is_dir():
        die(f"{root} yok")
    rows = []
    for path in glob.glob(str(root / "*" / "*.jsonl")):
        st = os.stat(path)
        age = (time.time() - st.st_mtime) / 60
        if not all_ and age > stale:
            continue
        rows.append({
            "session": os.path.basename(path)[:-6],
            "tag": os.path.basename(path)[:4],
            "project": os.path.basename(os.path.dirname(path)),
            "idle_min": round(age, 1),
            "size_kb": round(st.st_size / 1024),
        })
    rows.sort(key=lambda r: r["idle_min"])

    if as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=2), flush=True)
        return
    if not rows:
        err_console.print(f"[dim]son {stale:g} dakikada aktif oturum yok (--all ile hepsini gör)[/]")
        return
    table = Table(box=None, pad_edge=False, header_style="dim")
    table.add_column("etiket")
    table.add_column("proje")
    table.add_column("boş", justify="right")
    table.add_column("boyut", justify="right")
    for r in rows[:40]:
        table.add_row(
            Text(r["tag"], style=f"bold {lane_of(r['session'])}"),
            pretty_project(r["project"]),
            f"{r['idle_min']:.0f} dk", f"{r['size_kb']} KB",
        )
    out_console.print(table)


@app.command()
def replay(
    tag: str = typer.Argument(..., help="oturum etiketi ya da tam id (agent-stream sessions ile bak)"),
    max_lines: int = typer.Option(6, "-n", "--max-lines", metavar="N", help="çıktı satır sınırı"),
    max_cmd: int = typer.Option(10, "-m", "--max-cmd", metavar="N", help="komut bloğu satır sınırı (0 = sınırsız)"),
    all_tools: bool = typer.Option(False, "-a", "--all-tools", help="tüm araçlar"),
    no_color: bool = typer.Option(False, "--no-color", help="rengi kapat"),
    root: Path = typer.Option(DEFAULT_ROOT, "--root", envvar="AGENT_STREAM_ROOT", help="transcript kökü"),
):
    """Geçmiş bir oturumun tüm komutlarını baştan yaz (takip etmez)."""
    matches = [p for p in glob.glob(str(root / "*" / "*.jsonl")) if os.path.basename(p).startswith(tag)]
    if not matches:
        die(f"'{tag}' ile başlayan oturum yok", "agent-stream sessions --all ile etiketlere bakabilirsin.")
    if len(matches) > 1:
        die(f"'{tag}' birden çok oturumla eşleşti", "daha uzun bir önek ver: " +
            ", ".join(os.path.basename(m)[:8] for m in matches[:5]))

    console = setup_console(no_color)
    reader = Reader(root, None, None, all_tools, True, stale_min=float("inf"))
    reader.seen_files.add(matches[0])
    reader.offsets[matches[0]] = 0
    view = StreamView(console, max_lines, True, True, max_cmd)
    for kind, cmd in reader.poll():
        if kind == "end":          # oynatma canlı değil: komut çıktısıyla bitişik kalsın
            view.start(cmd)
            view.end(cmd)


