@dataclass
class Lane:
    key: str
    tag: str = "????"
    label: str = ""
    cwd: str = ""
    branch: str = ""
    sub: bool = False
    running: Cmd | None = None
    last: Cmd | None = None
    count: int = 0
    seen: float = field(default_factory=time.time)
    waiting: str = ""                 # "" · "ask" · "turn"
    ask: Note | None = None
    turn: str = ""                    # tur sonundaki ilk cümle
    prompt: str = ""                  # son insan satırı
    since: datetime | None = None     # bekleme başlangıcı
    ctx: int = 0
    model: str = ""
    warn: str = ""
    loop: bool = False                # son tur ScheduleWakeup ile bitti: döngü

    @property
    def order(self) -> tuple:
        """Sıra: soru bekleyen · tur bitmiş · çalışan/son görülen."""
        return ({"ask": 0, "turn": 1}.get(self.waiting, 2), -self.seen)


def apply(lanes: dict[str, Lane], kind: str, ev: Cmd | Note) -> tuple[Lane, bool]:
    """Bir olayı şerit durumuna işler; (şerit, yeni bekleme başladı mı) döner."""
    lane = lanes.setdefault(ev.key, Lane(ev.key))
    lane.tag, lane.label, lane.sub, lane.seen = ev.tag, ev.label, ev.sub, time.time()
    if ev.cwd:
        lane.cwd, lane.branch = ev.cwd, ev.branch
    fresh = False
    if kind == "start":
        lane.running, lane.waiting, lane.ask, lane.warn = ev, "", None, ""
    elif kind == "end":
        lane.running, lane.last, lane.count = None, ev, lane.count + 1
    elif kind == "human":
        lane.prompt, lane.waiting, lane.ask, lane.turn, lane.warn = ev.text, "", None, "", ""
        lane.loop = False
    elif kind == "fire":
        lane.prompt, lane.waiting, lane.ask, lane.loop = ev.text, "", None, True
    elif kind == "ask":
        lane.waiting, lane.ask, lane.since, fresh = "ask", ev, ev.ts, True
    elif kind == "answer":
        lane.waiting, lane.ask = "", None
    elif kind == "turn":
        if ev.extra.get("loop") or ev.extra.get("bg"):
            lane.waiting, lane.turn, lane.loop = "", ev.text, True
        elif lane.waiting != "ask":
            fresh = lane.waiting != "turn"
            lane.waiting, lane.turn, lane.since, lane.loop = "turn", ev.text, ev.ts, False
    elif kind == "ctx":
        lane.ctx, lane.model = int(ev.extra.get("tokens", 0)), str(ev.extra.get("model", ""))
    elif kind == "apierr":
        lane.warn = ev.text
    return lane, fresh


def lane_parts(lane: Lane, width: int, max_cmd: int) -> tuple[list[RenderableType], list[Text], int]:
    """Şeridin baş bloğu, çıktı kuyruğu ve baş bloğun kapladığı satır sayısı."""
    from rich.columns import Columns
    from rich.spinner import Spinner
    color = lane_of(lane.key)
    cmd = lane.running or lane.last
    inner = max(10, width - 4)
    head: list[RenderableType] = []
    used = 0

    if lane.waiting == "ask" and lane.ask:                 # soru komutun önüne geçer
        q = clip(lane.ask.extra.get("question", "").replace("\n", " "), inner * 2)
        head.append(Text(q, style="italic"))
        used += -(-cell_len(q) // inner) or 1
        for o in lane.ask.extra.get("options", [])[:6]:
            head.append(Text(f"○ {clip(o, inner - 2)}", style="yellow"))
            used += 1
        return head, [], used
    if lane.waiting == "turn":
        head.append(Text("■ tur bitti · seni bekliyor", style="bold"))
        used += 1
        if lane.turn:
            head.append(Text(clip(lane.turn, inner * 2), style="dim italic"))
            used += -(-cell_len(clip(lane.turn, inner * 2)) // inner) or 1
        if lane.prompt:
            head.append(Text(clip(f"» {lane.prompt}", inner), style="dim"))
            used += 1
    if lane.warn:
        head.append(Text(clip(f"⚠ {lane.warn}", inner), style="red"))
        used += 1
    if not cmd:
        return head + [Text("bekliyor…", style="dim italic")], [], used + 1

    # Komut şeritte de satır satır durur; heredoc tek satıra sıkıştırılınca okunmuyordu.
    rows = [clip(l, inner * 2) for l in (cmd.text.splitlines() or [""])[:max_cmd]]
    extra = len(cmd.text.splitlines()) - max_cmd
    text = "\n".join(rows) + (f"\n… +{extra} satır komut" if extra > 0 else "")
    head.append(highlight(text))
    used += sum(-(-cell_len(l) // inner) or 1 for l in text.splitlines())
    if cmd.desc:
        head.append(Text(clip(cmd.desc, inner), style="italic"))
        used += 1
    if lane.running:
        head.append(Columns([Spinner("dots", style=color),
                             Text(human_dur(lane.running.dur), style=color)], padding=(0, 1)))
        used += 1
    tail = [Text(clip(line, inner), style="dim") for line, _ in cmd.body]
    return head, tail, used


def lane_need(parts: tuple[list, list, int]) -> int:
    """Şeridin hiç kırpılmadan isteyeceği panel yüksekliği."""
    _, tail, used = parts
    return used + len(tail) + 3                            # boş satır + iki kenarlık


def lane_panel(lane: Lane, height: int, width: int, parts: tuple[list, list, int],
               ctx_window: int = CTX_WINDOW):
    from rich.panel import Panel
    head, tail, used = parts
    room = max(1, height - 3 - used)
    body = Group(*head, Text(""), *tail[-room:])

    color = lane_of(lane.key)
    title = Text(f"▌{lane.tag} ", style=f"bold {color}")
    title.append(short_path(lane.cwd), style="bold")
    if lane.branch and lane.branch != "HEAD":
        title.append(f" · {lane.branch}", style="dim")
    if lane.label:
        title.append(lane.label, style="dim italic")
    if lane.waiting == "ask" and lane.ask:
        title.append(f"  ? {lane.ask.text}", style="bold yellow")
    elif lane.waiting == "turn":
        title.append("  ■", style="bold")
    sub = Text()
    if lane.ctx:
        sub.append_text(ctx_bar(lane.ctx, ctx_window))
    if not lane.running and lane.last:
        sub.append("  " if lane.ctx else "")
        sub.append_text(status_text(lane.last))
    if lane.waiting and lane.since:
        wait = (datetime.now(tz=lane.since.tzinfo) - lane.since).total_seconds()
        sub.append(f"  ⧗ {short_dur(wait)}", style="yellow" if lane.waiting == "ask" else "dim")
    border = "yellow" if lane.waiting == "ask" else color if lane.running else "dim"
    return Panel(
        body, title=title, title_align="left",
        subtitle=sub if sub.plain else None, subtitle_align="right",
        border_style=border, height=height, width=width, padding=(0, 1),
    )


def dash_frame(lanes: dict[str, Lane], recent: list[Cmd], started: float,
               total: int, console: Console, cols: int, max_cmd: int = 4,
               ctx_window: int = CTX_WINDOW) -> RenderableType:
    from rich.columns import Columns
    from rich.panel import Panel
    from rich.table import Table
    active = sorted(lanes.values(), key=lambda l: l.order)   # bekleyen öne: pano bir kuyruk
    shown, hidden = active[:cols], max(0, len(active) - cols)

    header = Table.grid(expand=True)
    header.add_column(justify="left")
    header.add_column(justify="right")
    left = Text("agent-stream", style="bold")
    left.append("  pano", style="dim")
    asks = sum(1 for l in active if l.waiting == "ask")
    turns = sum(1 for l in active if l.waiting == "turn")
    if asks:
        left.append(f"   ? {asks} soru", style="bold yellow")
    if turns:
        left.append(f"   ■ {turns} tur bitti", style="bold")
    right = Text(f"{len(active)} şerit", style="bold")
    if hidden:
        right.append(f" (+{hidden} gizli)", style="dim")
    right.append(f" · {total} komut · ↑{human_dur(time.time() - started)}", style="dim")
    header.add_row(left, right)

    room = max(9, console.height - 4 - min(len(recent), 5))
    width = max(26, console.width // max(1, len(shown) or 1) - 1)
    parts = [lane_parts(l, width, max_cmd) for l in shown]
    height = min(room, max([9] + [lane_need(pt) for pt in parts])) if shown else room
    body = Columns([lane_panel(l, height, width, pt, ctx_window) for l, pt in zip(shown, parts)],
                   equal=True, expand=True) \
        if shown else Panel(Text("aktif oturum yok — Claude Code'da bir komut çalıştır", style="dim italic"),
                            border_style="dim", height=height)

    tail = Table.grid(padding=(0, 1))
    tail.add_column(style="dim", width=8)
    tail.add_column(width=4)
    tail.add_column(width=7, justify="right")
    tail.add_column(overflow="ellipsis", no_wrap=True)
    for c in recent[-5:]:
        tail.add_row(
            c.started.strftime("%H:%M:%S"),
            Text(c.tag, style=f"bold {c.lane}"),
            Text(human_dur(c.dur), style="green" if c.ok else "red"),
            Text(clip(c.text.replace("\n", " ⏎ "), console.width - 30), style="dim"),
        )
    return Group(header, body, tail)


