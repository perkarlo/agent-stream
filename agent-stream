def root_of(args) -> Path:
    return Path(getattr(args, "root", None) or DEFAULT_ROOT).expanduser()


def make_sink(args, cfg: dict, max_lines: int, show_desc: bool, show_output: bool, max_cmd: int):
    if not pick(args.serve, cfg, "serve", False):
        return None
    port = int(pick(args.port, cfg, "port", WEB_PORT, int))
    try:
        sink = WebSink(port, max_lines, show_desc, show_output, max_cmd)
    except OSError as exc:
        die(f"{port} kapısı açılamadı ({exc.strerror})", "--port ile başka kapı ver.")
    sink.announce(err_console)
    return sink


def cmd_stream(args) -> None:
    cfg = merged_config("stream")
    max_lines = int(pick(args.max_lines, cfg, "max_lines", 12, int))
    max_cmd = int(pick(args.max_cmd, cfg, "max_cmd", 6, int))
    stale = float(pick(args.stale, cfg, "stale", 30, float))
    base = float(pick(args.interval, cfg, "interval", 0.25, float))
    project = pick(args.project, cfg, "project", None)
    all_tools = pick(args.all_tools, cfg, "all_tools", True)
    subagents = args.subagents if args.subagents is not None else cfg.get("subagents", True)
    set_theme(str(pick(args.theme, cfg, "theme", "monokai")))
    root = root_of(args)
    if not root.is_dir():
        die(f"{root} yok", "Claude Code bu makinede hiç çalışmamış olabilir; --root ile başka bir kök verebilirsin.")

    console = setup_console(args.no_color)
    bell = bool(pick(args.bell, cfg, "bell", False))
    reader = Reader(root, project, args.session, all_tools, subagents, stale)
    view = StreamView(console, max_lines, args.desc, not args.quiet, max_cmd, bell)
    backfill = int(pick(args.backfill, cfg, "backfill", 0, int))
    sink = make_sink(args, cfg, max_lines, args.desc, not args.quiet, max_cmd)

    if not args.as_json:
        err_console.print(f"[dim]agent-stream {VERSION} · {project or 'tüm projeler'} · "
                          f"{reader.watcher.name} · çıkış Ctrl+C[/]", highlight=False)
    try:
        events = reader.poll(first=True, backfill=backfill)
        while True:
            for kind, cmd in events:
                if sink:
                    sink.feed(kind, cmd)
                if isinstance(cmd, Note):
                    if kind == "ctx" or not args.notes:
                        continue
                    if args.as_json:
                        print(json.dumps(cmd.as_json(), ensure_ascii=False), flush=True)
                    else:
                        view.note(cmd)
                elif args.as_json:
                    if kind == "end" and (cmd.ok is False or not args.errors):
                        print(json.dumps(cmd.as_json(), ensure_ascii=False), flush=True)
                elif kind == "start":
                    if not args.pair and not args.errors:
                        view.start(cmd)
                elif args.errors:
                    if not cmd.ok:                          # yalnız patlayanlar, eşli
                        view.start(cmd)
                        view.end(cmd)
                else:
                    if args.pair:
                        view.start(cmd)
                    view.end(cmd)
            reader.wait(base)
            events = reader.poll()
    finally:
        reader.close()
        if sink:
            sink.server.shutdown()


def cmd_dash(args) -> None:
    from rich.live import Live
    cfg = merged_config("dash")
    stale = float(pick(args.stale, cfg, "stale", 15, float))
    max_cmd = int(pick(args.max_cmd, cfg, "max_cmd", 4, int))
    cols = int(pick(args.lanes, cfg, "columns", 4, int))
    base = float(pick(args.interval, cfg, "interval", 0.25, float))
    project = pick(args.project, cfg, "project", None)
    all_tools = pick(args.all_tools, cfg, "all_tools", True)
    bell = bool(pick(args.bell, cfg, "bell", False))
    ctx_window = int(pick(None, cfg, "ctx_window", CTX_WINDOW, int))
    set_theme(str(pick(args.theme, cfg, "theme", "monokai")))
    root = root_of(args)
    if not root.is_dir():
        die(f"{root} yok", "--root ile transcript kökünü verebilirsin.")
    console = setup_console(False)
    if not console.is_terminal:
        die("pano bir terminal gerektirir", "boru hattında `agent-stream --json` kullan.", EXIT_USAGE)

    reader = Reader(root, project, args.session, all_tools, True, stale, tail=TAIL_BYTES)
    lanes: dict[str, Lane] = {}
    recent: list[Cmd] = []
    started, total, drawn = time.time(), 0, 0.0
    sink = make_sink(args, cfg, 6, True, True, max_cmd)

    for kind, ev in reader.poll(first=True):               # kuyruktan durum: kim bekliyor, bağlam
        lane, _ = apply(lanes, kind, ev)
        if isinstance(ev, Cmd):
            lane.seen = ev.started.timestamp()
    for lane in lanes.values():
        if lane.running and not lane.waiting:              # açılışta yarım kalan komut koşuyor sayılmaz
            lane.last, lane.running = lane.running, None
    try:
        # Kare yalnız durum değişince üretilir; koşan komut varken spinner için 4 fps.
        with Live(console=console, screen=True, auto_refresh=False, transient=True) as live:
            while True:
                changed = False
                for kind, ev in reader.poll():
                    lane, fresh = apply(lanes, kind, ev)
                    if sink:
                        sink.feed(kind, ev)
                    if kind == "start":
                        total += 1
                    elif kind == "end":
                        recent.append(ev)
                        recent[:] = recent[-20:]
                    if fresh and bell:
                        ring()
                    changed = changed or kind != "ctx"
                cutoff = time.time() - stale * 60
                # Bekleyen şerit dört kat daha uzun kalır: soru kaçmasın, kapanmış oturum da sonsuza dek durmasın.
                for key in [k for k, l in lanes.items()
                            if l.seen < (cutoff - 3 * stale * 60 if l.waiting else cutoff)]:
                    del lanes[key]
                    changed = True

                running = any(l.running for l in lanes.values())
                now = time.time()
                if changed or (running and now - drawn >= 0.25) or now - drawn >= 5.0:
                    live.update(dash_frame(lanes, recent, started, total, console, cols, max_cmd, ctx_window),
                                refresh=True)
                    drawn = now
                reader.wait(base if running else 1.0)
    finally:
        reader.close()
        if sink:
            sink.server.shutdown()


def cmd_sessions(args) -> None:
    from rich.table import Table
    cfg = merged_config("sessions")
    stale = float(pick(None if args.stale == 60 else args.stale, cfg, "stale", 60, float))
    root = root_of(args)
    if not root.is_dir():
        die(f"{root} yok")
    rows = []
    for path in glob.glob(str(root / "*" / "*.jsonl")):
        st = os.stat(path)
        age = (time.time() - st.st_mtime) / 60
        if not args.all_ and age > stale:
            continue
        rows.append({
            "session": os.path.basename(path)[:-6],
            "tag": os.path.basename(path)[:4],
            "project": os.path.basename(os.path.dirname(path)),
            "idle_min": round(age, 1),
            "size_kb": round(st.st_size / 1024),
        })
    rows.sort(key=lambda r: r["idle_min"])

    if args.as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=2), flush=True)
        return
    if not rows:
        err_console.print(f"[dim]son {stale:g} dakikada aktif oturum yok (--all ile hepsini gör)[/]")
        return
    table = Table(box=None, pad_edge=False, header_style="dim")
    table.add_column("etiket")
    table.add_column("proje")
    table.add_column("boş", justify="right")
    table.add_column("boyut", justify="right")
    for r in rows[:40]:
        table.add_row(
            Text(r["tag"], style=f"bold {lane_of(r['session'])}"),
            pretty_project(r["project"]),
            f"{r['idle_min']:.0f} dk", f"{r['size_kb']} KB",
        )
    out_console.print(table)


def seed_lanes(root: Path, project: str | None, stale: float) -> dict[str, Lane]:
    """Aktif oturumların kuyruğundan şerit durumu kurar; canlı takip etmez."""
    reader = Reader(root, project, None, True, False, stale, watch=False, tail=TAIL_BYTES)
    lanes: dict[str, Lane] = {}
    for kind, ev in reader.poll(first=True):
        lane, _ = apply(lanes, kind, ev)
        lane.seen = (ev.started if isinstance(ev, Cmd) else ev.ts).timestamp()
    reader.close()
    return lanes


def cmd_wait(args) -> None:
    from rich.table import Table
    cfg = merged_config("wait")
    stale = float(pick(args.stale, cfg, "stale", 120, float))
    project = pick(args.project, cfg, "project", None)
    ctx_window = int(pick(None, cfg, "ctx_window", CTX_WINDOW, int))
    root = root_of(args)
    if not root.is_dir():
        die(f"{root} yok")
    lanes = sorted(seed_lanes(root, project, stale).values(), key=lambda l: l.order)
    if not args.all_:
        lanes = [l for l in lanes if l.waiting]
    now = datetime.now().astimezone()
    rows = []
    for l in lanes:
        wait = (now - l.since).total_seconds() if l.since else 0.0
        rows.append({
            "session": l.key.split("#")[0], "tag": l.tag, "project": os.path.basename(l.cwd) or "~",
            "branch": l.branch, "state": l.waiting or ("running" if l.running else "loop" if l.loop else "idle"),
            "header": l.ask.text if l.ask else "",
            "question": l.ask.extra.get("question", "") if l.ask else "",
            "options": l.ask.extra.get("options", []) if l.ask else [],
            "turn": l.turn, "prompt": l.prompt, "waiting_s": round(wait) if l.waiting else 0,
            "ctx_tokens": l.ctx, "model": l.model,
        })
    if args.as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=2), flush=True)
        return
    if not rows:
        err_console.print("[dim]seni bekleyen oturum yok[/]")
        return
    table = Table(box=None, pad_edge=False, header_style="dim", expand=True)
    for col, w in (("etiket", 6), ("proje", 14), ("durum", 18), ("süre", 7), ("bağlam", 11), ("model", 9)):
        table.add_column(col, min_width=w, justify="right" if col in ("süre", "bağlam") else "left",
                         overflow="ellipsis", no_wrap=True)
    table.add_column("son satır", ratio=1, overflow="ellipsis", no_wrap=True)
    for l, r in zip(lanes, rows):
        if r["state"] == "ask":
            state = Text(f"? {r['header']}", style="bold yellow")
            last = " / ".join(r["options"][:4])
        elif r["state"] == "turn":
            state = Text("■ tur bitti", style="bold")
            last = r["turn"]
        elif r["state"] == "running":
            state, last = Text("● çalışıyor", style="green"), (l.running.text if l.running else "")
        elif l.loop:
            state, last = Text("⟳ döngü", style="dim"), r["turn"]
        else:
            state, last = Text("· boşta", style="dim"), r["turn"]
        table.add_row(
            Text(r["tag"], style=f"bold {lane_of(l.key)}"),
            r["project"] + (f" · {r['branch']}" if r["branch"] and r["branch"] != "HEAD" else ""),
            state, short_dur(r["waiting_s"]) if r["waiting_s"] else "",
            ctx_bar(r["ctx_tokens"], ctx_window) if r["ctx_tokens"] else Text(""),
            pretty_model(r["model"]) if r["model"] else "",
            Text(clip(last.replace("\n", " "), 60), style="dim"),
        )
    out_console.print(table)


def parse_since(text: str) -> float:
    """`24h` · `7d` · `90m` → saniye."""
    m = re.fullmatch(r"(\d+)([mhd])", text.strip())
    if not m:
        die(f"anlaşılmayan süre: {text}", "örnek: 90m · 24h · 7d", EXIT_USAGE)
    return int(m.group(1)) * {"m": 60, "h": 3600, "d": 86400}[m.group(2)]


def cmd_stats(args) -> None:
    from rich.table import Table
    cfg = merged_config("stats")
    since = parse_since(str(pick(args.since, cfg, "since", "7d")))
    project = pick(args.project, cfg, "project", None)
    root = root_of(args)
    if not root.is_dir():
        die(f"{root} yok")
    cutoff = time.time() - since
    files = [p for p in glob.glob(str(root / "**" / "*.jsonl"), recursive=True)
             if (not project or project.lower() in p.lower()) and os.stat(p).st_mtime >= cutoff]
    tools: dict[str, int] = {}
    models: dict[str, int] = {}
    projects: dict[str, int] = {}
    hours = [0] * 24
    sessions: set[str] = set()
    n_cmd = n_err = n_human = n_ask = n_turn = n_compact = n_apierr = out_tok = 0
    open_ids: dict[str, str] = {}
    for path in files:
        try:
            with open(path, "rb") as fh:
                raw = fh.read()
        except OSError:
            continue
        sid = os.path.basename(path)[:-6]
        for line in raw.decode("utf-8", errors="replace").splitlines():
            if not any(m in line for m in MARKS):
                continue
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            ts = parse_ts(e.get("timestamp"))
            if ts.timestamp() < cutoff:
                continue
            typ, msg = e.get("type"), e.get("message") or {}
            content = msg.get("content")
            if typ == "assistant":
                models[str(msg.get("model", "?"))] = models.get(str(msg.get("model", "?")), 0) + 1
                out_tok += int((msg.get("usage") or {}).get("output_tokens") or 0)
                if msg.get("stop_reason") == "end_turn" and not (e.get("isSidechain") or e.get("agentId")):
                    n_turn += 1
            elif typ == "user":
                origin = (e.get("origin") or {}).get("kind")
                if isinstance(content, str) and not e.get("isMeta") and \
                        (origin == "human" or (origin is None and "<command-message>" not in content)):
                    n_human += 1
                    sessions.add(sid)
                if e.get("isCompactSummary"):
                    n_compact += 1
            elif typ == "system":
                n_apierr += e.get("subtype") == "api_error"
                n_compact += e.get("subtype") == "compact_boundary"
            if not isinstance(content, list):
                continue
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "tool_use":
                    name = b.get("name", "")
                    if name in ASKS:
                        n_ask += 1
                        continue
                    if name == "TodoWrite":
                        continue
                    n_cmd += 1
                    hours[ts.hour] += 1
                    tools[name] = tools.get(name, 0) + 1
                    proj = pretty_project(os.path.relpath(path, root).split(os.sep)[0])
                    projects[proj] = projects.get(proj, 0) + 1
                    open_ids[b.get("id", "")] = name
                elif b.get("type") == "tool_result" and b.get("tool_use_id") in open_ids:
                    open_ids.pop(b.get("tool_use_id"))
                    n_err += bool(b.get("is_error"))
    night = sum(hours[0:6])
    summary = {
        "since": str(args.since or cfg.get("since", "7d")), "files": len(files),
        "sessions_with_prompts": len(sessions), "prompts": n_human, "commands": n_cmd,
        "errors": n_err, "asks": n_ask, "turns": n_turn, "compactions": n_compact,
        "api_errors": n_apierr, "output_tokens": out_tok,
        "night_share": round(night / n_cmd, 3) if n_cmd else 0.0,
        "tools": dict(sorted(tools.items(), key=lambda kv: -kv[1])),
        "models": dict(sorted(models.items(), key=lambda kv: -kv[1])),
        "projects": dict(sorted(projects.items(), key=lambda kv: -kv[1])),
        "hours": hours,
    }
    if args.as_json:
        print(json.dumps(summary, ensure_ascii=False, indent=2), flush=True)
        return
    if not n_cmd:
        err_console.print(f"[dim]son {summary['since']} içinde komut yok[/]")
        return
    peak = max(hours) or 1
    bars = "".join("▁▂▃▄▅▆▇█"[min(7, round(h / peak * 7))] if h else " " for h in hours)
    t = Table(box=None, pad_edge=False, show_header=False)
    t.add_column(style="dim", justify="right")
    t.add_column()
    t.add_row("pencere", f"son {summary['since']} · {len(files)} transcript")
    t.add_row("oturum", f"{len(sessions)} (senin yazdığın) · {n_human} istek · {n_ask} soru · {n_turn} tur")
    err_style = "red" if n_err else "green"
    t.add_row("komut", Text.assemble(f"{n_cmd} · ", (f"{n_err} hata", err_style),
                                     f" · {n_compact} özetleme · {n_apierr} api hatası", style=""))
    t.add_row("araç", " · ".join(f"{glyph_of(k)} {pretty_tool(k)} {v}".replace("· ", "")
                                 for k, v in list(summary["tools"].items())[:7]))
    t.add_row("model", " · ".join(f"{pretty_model(k)} {v}" for k, v in summary["models"].items())
              + f"  ·  {human_tok(out_tok)} çıktı token")
    t.add_row("proje", " · ".join(f"{k} {v}" for k, v in list(summary["projects"].items())[:6]))
    t.add_row("saat", Text.assemble(("00 ", "dim"), bars, (" 23", "dim"),
                                    (f"   gece 00-06: %{night * 100 / n_cmd:.0f}", "dim")))
    out_console.print(t)


def cmd_replay(args) -> None:
    cfg = merged_config("replay")
    max_lines = int(pick(args.max_lines, cfg, "max_lines", 6, int))
    max_cmd = int(pick(args.max_cmd, cfg, "max_cmd", 10, int))
    all_tools = pick(args.all_tools, cfg, "all_tools", True)
    set_theme(str(pick(args.theme, cfg, "theme", "monokai")))
    root = root_of(args)
    matches = [p for p in glob.glob(str(root / "**" / "*.jsonl"), recursive=True)
               if os.path.basename(p).startswith(args.tag)]
    if not matches:
        die(f"'{args.tag}' ile başlayan oturum yok",
            "agent-stream sessions --all ile etiketlere bakabilirsin.")
    if len(matches) > 1:
        die(f"'{args.tag}' birden çok oturumla eşleşti",
            "daha uzun bir önek ver: " + ", ".join(os.path.basename(m)[:8] for m in matches[:5]))

    console = setup_console(args.no_color)
    reader = Reader(root, None, None, all_tools, True, stale_min=float("inf"), watch=False)
    reader.seen_files.add(matches[0])
    reader.offsets[matches[0]] = 0
    reader._paths = [matches[0]]
    reader._scanned = time.time()
    reader._need_scan = False
    view = StreamView(console, max_lines, True, True, max_cmd)
    for kind, cmd in reader.poll():
        if isinstance(cmd, Note):
            if kind != "ctx":
                view.note(cmd)
        elif kind == "end":        # oynatma canlı değil: komut çıktısıyla bitişik kalsın
            view.start(cmd)
            view.end(cmd)


def main(argv: list[str] | None = None) -> None:
    args = build_parser().parse_args(argv)
    {"dash": cmd_dash, "sessions": cmd_sessions, "replay": cmd_replay,
     "wait": cmd_wait, "stats": cmd_stats}.get(
        getattr(args, "cmd", None) or "stream", cmd_stream)(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        err_console.print("\n[dim]durduruldu[/]")
        sys.exit(EXIT_SIGINT)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(EXIT_OK)
