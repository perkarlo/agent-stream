def lane_print(console: Console, color: str, renderable: RenderableType, marker: str = " ") -> None:
    """Her satırın başına oturum renginde şerit çubuğu yapıştırarak basar."""
    opts = console.options.update(width=max(20, console.width - 3))
    style = console.get_style(color)
    first, rest = Segment(f"▌{marker} ", style), Segment("▌  ", style)
    for i, line in enumerate(console.render_lines(renderable, opts, pad=False)):
        console.print(Segments([first if i == 0 else rest, *line, Segment("\n")]),
                      end="", highlight=False)


def head_text(cmd: Cmd, desc: bool = True) -> Text:
    t = Text(cmd.started.strftime("%H:%M:%S "), style="dim")
    t.append(cmd.tag, style=f"bold {cmd.lane}")
    t.append(f"  {short_path(cmd.cwd)}", style="dim")
    if cmd.branch and cmd.branch != "HEAD":
        t.append(f"  {cmd.branch}", style="dim italic")
    if cmd.sub:
        t.append(f"  {cmd.label.strip()}", style="dim italic")
    if desc and cmd.desc:
        t.append(f"  · {cmd.desc}", style="italic")
    return t


def cut_cmd(text: str, max_cmd: int) -> str:
    """Heredoc'lu komutlar `max_cmd` satırda kırpılır (0 = sınırsız)."""
    lines = text.splitlines()
    if not max_cmd or len(lines) <= max_cmd:
        return text
    return "\n".join(lines[:max_cmd]) + f"\n… +{len(lines) - max_cmd} satır komut"


def cmd_block(cmd: Cmd, color: bool, max_cmd: int = 0) -> RenderableType:
    text = cut_cmd(cmd.text, max_cmd)
    if cmd.tool != "Bash" or not color:
        return Text(text, style="bold", overflow="fold")
    return highlight(text)


def status_text(cmd: Cmd, prefix: str = "") -> Text:
    n = len(cmd.body)
    mark, style = ("✓", "green") if cmd.ok else ("✗", "red")
    t = Text(prefix, style="dim")
    t.append(mark, style=style)
    t.append(f" {human_dur(cmd.dur)}", style="dim")
    t.append(f" · {n} satır" if n else " · çıktı yok", style="dim")
    return t


class StreamView:
    def __init__(self, console: Console, max_lines: int, show_desc: bool, show_output: bool,
                 max_cmd: int = 6, bell: bool = False):
        self.c, self.max_lines, self.show_desc, self.show_output = console, max_lines, show_desc, show_output
        self.max_cmd, self.bell = max_cmd, bell
        self.last_uid = ""

    def note(self, n: Note) -> None:
        """Komut dışı olay tek satır; soru seçenekleriyle, tur sonu ilk cümlesiyle düşer."""
        g = NOTE_GLYPH.get(n.kind, "·")
        head = Text(n.ts.strftime("%H:%M:%S "), style="dim")
        head.append(n.tag, style=f"bold {n.lane}")
        width = self.c.width - 14
        if n.kind == "human":
            head.append("  " + clip(n.text.replace("\n", " ⏎ "), width), style="bold")
        elif n.kind == "fire":
            tail = "  · arka plan işi bitti" if n.extra.get("task") else "  · döngü uyandı"
            head.append("  " + clip(n.text, width) + tail, style="dim")
        elif n.kind == "ask":
            head.append(f"  {n.text}", style="bold yellow")
            head.append("  · seni bekliyor", style="yellow")
        elif n.kind == "answer":
            head.append(f"  {n.extra.get('header', '')}: ", style="dim")
            head.append(clip(n.text, width), style="italic")
        elif n.kind == "turn":
            quiet = n.extra.get("loop") or n.extra.get("bg")
            label = "  döngü, sıradaki uyanışı bekliyor" if n.extra.get("loop") \
                else f"  arka plan işi bekliyor ({n.extra.get('bg')})" if n.extra.get("bg") else "  tur bitti"
            head.append(label, style="dim" if quiet else "bold")
            if n.text:
                head.append(f"  · {clip(n.text, width)}", style="dim italic")
        elif n.kind == "compact":
            head.append(f"  {n.text}", style="magenta")
        elif n.kind == "apierr":
            head.append(f"  {clip(n.text, width)}", style="red")
        else:
            return
        self.c.print()
        lane_print(self.c, n.lane, head, g)
        if n.kind == "ask":
            q = clip(n.extra.get("question", "").replace("\n", " "), width)
            if q:
                lane_print(self.c, n.lane, Text(q, style="italic"))
            for o in n.extra.get("options", [])[:6]:
                lane_print(self.c, n.lane, Text(f"○ {clip(o, width - 2)}", style="yellow"))
        if self.bell and (n.kind == "ask" or (n.kind == "turn" and not (n.extra.get("loop") or n.extra.get("bg")))):
            ring()
        self.c.file.flush()

    def start(self, cmd: Cmd) -> None:
        self.c.print()
        self.last_uid = cmd.uid
        lane_print(self.c, cmd.lane, head_text(cmd, self.show_desc))
        color = self.c.is_terminal and not self.c.no_color
        lane_print(self.c, cmd.lane, cmd_block(cmd, color, self.max_cmd), glyph_of(cmd.tool))

    def end(self, cmd: Cmd) -> None:
        # Paralel komutlarda çıktı başka bir başlığın altına düşebilir: yeniden çapala.
        if cmd.uid != self.last_uid:
            anchor = Text("↳ ", style="dim")
            anchor.append(clip(cmd.text.replace("\n", " ⏎ "), self.c.width - 8), style="dim italic")
            lane_print(self.c, cmd.lane, anchor)
        self.last_uid = ""
        # -q çıktıyı gizler ama patlayan komutun nedeni görünmeli: hatada 3 satır.
        limit = self.max_lines if self.show_output else (3 if not cmd.ok else 0)
        if limit:
            lines = cmd.body
            for text, is_err in lines[:limit]:
                body = Text(clip(text, self.c.width - 6), style="red" if is_err else "dim")
                lane_print(self.c, cmd.lane, body)
            rest = len(lines) - limit
            if rest > 0:
                lane_print(self.c, cmd.lane, Text(f"… +{rest} satır", style="dim italic"))
        lane_print(self.c, cmd.lane, status_text(cmd, "└ "))
        self.c.file.flush()


