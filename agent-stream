VERSION = "1.0.0"
HOME = Path.home()
DEFAULT_ROOT = Path(os.environ.get("AGENT_STREAM_ROOT", HOME / ".claude" / "projects"))
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "agent-stream" / "config.toml"

EXIT_OK, EXIT_ERR, EXIT_USAGE, EXIT_SIGINT = 0, 1, 2, 130

ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")
SYSREM = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
CTRL = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f]")

# ─── Şerit renkleri ─────────────────────────────────────────────────────────
# Renk oturum id'sinden türer: takipçi yeniden başlasa da aynı oturum aynı renkte.
LANES = ["cyan", "magenta", "green", "yellow", "blue", "bright_magenta", "bright_cyan", "bright_red"]
GLYPH = {
    "Bash": "$", "Read": "▸", "Edit": "✎", "Write": "✎", "NotebookEdit": "✎",
    "Grep": "⌕", "Glob": "⌕", "WebSearch": "⌕", "WebFetch": "⇣", "Task": "⤷", "Agent": "⤷",
}

out_console = Console()             # veri → stdout
err_console = Console(stderr=True)  # banner, uyarı, hata → stderr


# ─── Yardımcılar ────────────────────────────────────────────────────────────

def die(msg: str, hint: str = "", code: int = EXIT_ERR) -> None:
    err_console.print(f"[bold red]hata:[/] {msg}", highlight=False)
    if hint:
        err_console.print(f"      {hint}", style="dim", highlight=False)
    raise typer.Exit(code)


def lane_of(sid: str) -> str:
    return LANES[sum(sid.encode()) % len(LANES)]


def pretty_project(name: str) -> str:
    """`-Users-ben-Documents-myapp` → `myapp`; ev dizininin kendisi → `~`."""
    home = str(HOME).replace("/", "-")
    if name == home:
        return "~"
    return name.removeprefix(f"{home}-Documents-").removeprefix(f"{home}-") or "~"


def short_path(p: str) -> str:
    if not p:
        return "?"
    p = p.replace(str(HOME), "~")
    parts = p.rstrip("/").split("/")
    return "/".join(parts[-2:]) if len(parts) > 2 else p


def clean(text: str | None) -> str:
    """Çıktıdan system-reminder bloklarını, ANSI dizilerini ve kontrol baytlarını atar."""
    text = SYSREM.sub("", text or "")
    return CTRL.sub("", ANSI.sub("", text)).rstrip()


def clip(s: str, n: int) -> str:
    return s if len(s) <= n else s[: n - 1] + "…"


def parse_ts(iso: str | None) -> datetime:
    if not iso:
        return datetime.now()
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return datetime.now()


def human_dur(sec: float) -> str:
    if sec < 1:
        return f"{sec * 1000:.0f}ms"
    if sec < 60:
        return f"{sec:.1f}s"
    return f"{int(sec // 60)}dk {int(sec % 60)}s"


# ─── Veri katmanı ───────────────────────────────────────────────────────────

@dataclass
class Cmd:
    uid: str
    sid: str
    cwd: str
    branch: str
    sub: bool
    tool: str
    text: str
    desc: str
    started: datetime
    ended: datetime | None = None
    out: str = ""
    err: str = ""
    ok: bool = True

    @property
    def tag(self) -> str:
        return self.sid[:4]

    @property
    def lane(self) -> str:
        return lane_of(self.sid)

    @property
    def dur(self) -> float:
        end = self.ended or datetime.now(tz=self.started.tzinfo)
        return max(0.0, (end - self.started).total_seconds())

    @property
    def body(self) -> list[tuple[str, bool]]:
        """Çıktı satırları: (metin, stderr mi)."""
        return [(l, False) for l in self.out.splitlines()] + [(l, True) for l in self.err.splitlines()]

    def as_json(self) -> dict:
        return {
            "ts": self.started.isoformat(timespec="seconds"),
            "session": self.sid,
            "cwd": self.cwd,
            "branch": self.branch,
            "subagent": self.sub,
            "tool": self.tool,
            "command": self.text,
            "description": self.desc,
            "duration_ms": round(self.dur * 1000),
            "ok": self.ok,
            "stdout": self.out,
            "stderr": self.err,
        }


class Reader:
    """Eşleşen transcript'leri takip eder; ('start'|'end', Cmd) olayları üretir."""

    def __init__(self, root: Path, project: str | None, session: str | None,
                 all_tools: bool, subagents: bool, stale_min: float):
        self.root, self.project, self.session = root, project, session
        self.all_tools, self.subagents, self.stale_min = all_tools, subagents, stale_min
        self.offsets: dict[str, int] = {}
        self.open: dict[str, Cmd] = {}
        self.seen_files: set[str] = set()

    # -- dosya keşfi
    def files(self) -> Iterable[tuple[str, os.stat_result]]:
        now = time.time()
        for path in glob.glob(str(self.root / "*" / "*.jsonl")):
            if self.project and self.project.lower() not in path.lower():
                continue
            if self.session and not os.path.basename(path).startswith(self.session):
                continue
            try:
                st = os.stat(path)
            except OSError:
                continue
            if path not in self.seen_files and now - st.st_mtime > self.stale_min * 60:
                continue
            yield path, st

    def wanted(self, tool: str) -> bool:
        return tool != "TodoWrite" if self.all_tools else tool == "Bash"

    # -- ayrıştırma
    def _summary(self, tool: str, inp: dict) -> str:
        if tool == "Bash":
            return str(inp.get("command", ""))
        arg = inp.get("file_path") or inp.get("pattern") or inp.get("url") or inp.get("query") \
            or inp.get("prompt") or json.dumps(inp, ensure_ascii=False)
        return f"{tool} {clip(str(arg).replace(chr(10), ' '), 160)}"

    def _result(self, entry: dict, block: dict) -> tuple[str, str, bool]:
        tur = entry.get("toolUseResult")
        if isinstance(tur, dict):
            o, e = clean(tur.get("stdout", "")), clean(tur.get("stderr", ""))
            if tur.get("interrupted"):
                return o, (e + "\n[kesildi]").strip(), False
            return o, e, not block.get("is_error", False)
        content = block.get("content")
        if isinstance(content, list):
            content = "\n".join(b.get("text", "") for b in content if isinstance(b, dict))
        text = clean(content if isinstance(content, str) else "")
        return ("", text, False) if block.get("is_error") else (text, "", True)

    def _events(self, entry: dict) -> Iterable[tuple[str, Cmd]]:
        content = (entry.get("message") or {}).get("content")
        if not isinstance(content, list):
            return
        for block in content:
            if not isinstance(block, dict):
                continue
            kind = block.get("type")
            if kind == "tool_use":
                tool = block.get("name", "")
                if not self.wanted(tool):
                    continue
                sub = bool(entry.get("isSidechain"))
                if sub and not self.subagents:
                    continue
                cmd = Cmd(
                    uid=block.get("id", ""), sid=entry.get("sessionId", "????"),
                    cwd=entry.get("cwd", ""), branch=entry.get("gitBranch", ""), sub=sub,
                    tool=tool, text=self._summary(tool, block.get("input") or {}),
                    desc=str((block.get("input") or {}).get("description", "")),
                    started=parse_ts(entry.get("timestamp")),
                )
                self.open[cmd.uid] = cmd
                yield "start", cmd
            elif kind == "tool_result":
                cmd = self.open.pop(block.get("tool_use_id", ""), None)
                if not cmd:
                    continue
                cmd.out, cmd.err, cmd.ok = self._result(entry, block)
                cmd.ended = parse_ts(entry.get("timestamp"))
                yield "end", cmd

    # -- okuma turu
    def poll(self, first: bool = False, backfill: int = 0) -> list[tuple[str, Cmd]]:
        events: list[tuple[str, Cmd]] = []
        for path, st in self.files():
            fresh = path not in self.seen_files
            if fresh:
                self.seen_files.add(path)
                # Yeni dosya akışa sonundan katılır; geriye dönük okuma yalnız --backfill ile.
                self.offsets[path] = 0 if (first and backfill) else st.st_size
            if st.st_size < self.offsets[path]:      # kırpılmış / döndürülmüş
                self.offsets[path] = 0
            if st.st_size == self.offsets[path]:
                continue
            try:
                with open(path, "r", errors="replace") as fh:
                    fh.seek(self.offsets[path])
                    data = fh.read()
                    self.offsets[path] = fh.tell()
            except OSError:
                continue
            lines = data.splitlines()
            if first and backfill:
                lines = lines[-backfill * 6:]
            for line in lines:
                if '"tool_use"' not in line and '"tool_result"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                events.extend(self._events(entry))
        if first and backfill:
            starts = [e for e in events if e[0] == "start"]
            keep = {c.uid for _, c in starts[-backfill:]}
            events = [(k, c) for k, c in events if c.uid in keep]
        return events


# ─── Akış görünümü ──────────────────────────────────────────────────────────

def lane_print(console: Console, color: str, renderable: RenderableType, marker: str = " ") -> None:
    """Her satırın başına oturum renginde şerit çubuğu yapıştırarak basar."""
    opts = console.options.update(width=max(20, console.width - 3))
    style = console.get_style(color)
    first, rest = Segment(f"▌{marker} ", style), Segment("▌  ", style)
    for i, line in enumerate(console.render_lines(renderable, opts, pad=False)):
        console.print(Segments([first if i == 0 else rest, *line, Segment("\n")]),
                      end="", highlight=False)


def head_text(cmd: Cmd) -> Text:
    t = Text(cmd.started.strftime("%H:%M:%S "), style="dim")
    t.append(cmd.tag, style=f"bold {cmd.lane}")
    t.append(f"  {short_path(cmd.cwd)}", style="dim")
    if cmd.branch and cmd.branch != "HEAD":
        t.append(f"  {cmd.branch}", style="dim italic")
    if cmd.sub:
        t.append("  ⤷ subagent", style="dim italic")
    return t


def cmd_block(cmd: Cmd, color: bool, max_cmd: int = 0) -> RenderableType:
    """Komut bloğu; heredoc'lu komutlar `max_cmd` satırda kırpılır (0 = sınırsız)."""
    text = cmd.text
    lines = text.splitlines()
    if max_cmd and len(lines) > max_cmd:
        text = "\n".join(lines[:max_cmd]) + f"\n… +{len(lines) - max_cmd} satır komut"
    if cmd.tool != "Bash" or not color:
        return Text(text, style="bold", overflow="fold")
    return Syntax(text, "bash", theme="ansi_dark", word_wrap=True, background_color="default")


def status_text(cmd: Cmd, prefix: str = "") -> Text:
    n = len(cmd.body)
    mark, style = ("✓", "green") if cmd.ok else ("✗", "red")
    t = Text(prefix, style="dim")
    t.append(mark, style=style)
    t.append(f" {human_dur(cmd.dur)}", style="dim")
    t.append(f" · {n} satır" if n else " · çıktı yok", style="dim")
    return t


class StreamView:
    def __init__(self, console: Console, max_lines: int, show_desc: bool, show_output: bool,
                 max_cmd: int = 10):
        self.c, self.max_lines, self.show_desc, self.show_output = console, max_lines, show_desc, show_output
        self.max_cmd = max_cmd
        self.last_uid = ""

    def start(self, cmd: Cmd) -> None:
        self.c.print()
        self.last_uid = cmd.uid
        lane_print(self.c, cmd.lane, head_text(cmd))
        marker = "$" if cmd.tool == "Bash" else GLYPH.get(cmd.tool, "·")
        color = self.c.is_terminal and not self.c.no_color
        lane_print(self.c, cmd.lane, cmd_block(cmd, color, self.max_cmd), marker)
        if self.show_desc and cmd.desc:
            lane_print(self.c, cmd.lane, Text(f"· {cmd.desc}", style="dim italic"))

    def end(self, cmd: Cmd) -> None:
        # Paralel komutlarda çıktı başka bir başlığın altına düşebilir: yeniden çapala.
        if cmd.uid != self.last_uid:
            anchor = Text("↳ ", style="dim")
            anchor.append(clip(cmd.text.replace("\n", " ⏎ "), self.c.width - 8), style="dim italic")
            lane_print(self.c, cmd.lane, anchor)
        self.last_uid = ""
        if self.show_output:
            lines = cmd.body
            for text, is_err in lines[: self.max_lines]:
                body = Text(clip(text, self.c.width - 6), style="red" if is_err else "dim")
                lane_print(self.c, cmd.lane, body)
            rest = len(lines) - self.max_lines
            if rest > 0:
                lane_print(self.c, cmd.lane, Text(f"… +{rest} satır", style="dim italic"))
        lane_print(self.c, cmd.lane, status_text(cmd, "└ "))
        self.c.file.flush()


# ─── Pano görünümü ──────────────────────────────────────────────────────────

@dataclass
class Lane:
    sid: str
    cwd: str = ""
    branch: str = ""
    running: Cmd | None = None
    last: Cmd | None = None
    count: int = 0
    seen: float = field(default_factory=time.time)


def lane_panel(lane: Lane, height: int, width: int) -> Panel:
    """Tek oturum şeridi: üstte komut, altta terminal gibi aşağıya yapışan çıktı kuyruğu."""
    color = lane_of(lane.sid)
    cmd = lane.running or lane.last
    inner = max(10, width - 4)
    head: list[RenderableType] = []
    tail: list[RenderableType] = []
    used = 0

    if cmd:
        text = clip(cmd.text.replace("\n", " ⏎ "), inner * 3)
        head.append(Syntax(text, "bash", theme="ansi_dark", word_wrap=True, background_color="default"))
        used += -(-len(text) // inner)                     # sarılmış komut satırı sayısı
        if cmd.desc:
            head.append(Text(clip(cmd.desc, inner), style="dim italic"))
            used += 1
        if lane.running:
            head.append(Columns([Spinner("dots", style=color),
                                 Text(human_dur(lane.running.dur), style=color)], padding=(0, 1)))
            used += 1
        tail = [Text(clip(line, inner), style="dim") for line, _ in cmd.body]
    else:
        head.append(Text("bekliyor…", style="dim italic"))
        used += 1

    room = max(1, height - 2 - used)
    body = Group(*head, Align(Group(*tail[-room:]), vertical="bottom", height=room))

    title = Text(f"▌{lane.sid[:4]} ", style=f"bold {color}")
    title.append(short_path(lane.cwd), style="bold")
    if lane.branch and lane.branch != "HEAD":
        title.append(f" · {lane.branch}", style="dim")
    return Panel(
        body, title=title, title_align="left",
        subtitle=None if lane.running else (status_text(lane.last) if lane.last else None),
        subtitle_align="right",
        border_style=color if lane.running else "dim",
        height=height, width=width, padding=(0, 1),
    )


def dash_frame(lanes: dict[str, Lane], recent: list[Cmd], started: float,
               total: int, console: Console, cols: int) -> RenderableType:
    active = sorted(lanes.values(), key=lambda l: -l.seen)
    shown, hidden = active[:cols], max(0, len(active) - cols)

    header = Table.grid(expand=True)
    header.add_column(justify="left")
    header.add_column(justify="right")
    left = Text("agent-stream", style="bold")
    left.append("  pano", style="dim")
    right = Text(f"{len(active)} oturum", style="bold")
    if hidden:
        right.append(f" (+{hidden} gizli)", style="dim")
    right.append(f" · {total} komut · ↑{human_dur(time.time() - started)}", style="dim")
    header.add_row(left, right)

    height = max(9, console.height - 4 - min(len(recent), 5))
    width = max(26, console.width // max(1, len(shown) or 1) - 1)
    body = Columns([lane_panel(l, height, width) for l in shown], equal=True, expand=True) \
        if shown else Panel(Text("aktif oturum yok — Claude Code'da bir komut çalıştır", style="dim italic"),
                            border_style="dim", height=height)

    tail = Table.grid(padding=(0, 1))
    tail.add_column(style="dim", width=8)
    tail.add_column(width=4)
    tail.add_column(width=7, justify="right")
    tail.add_column(overflow="ellipsis", no_wrap=True)
    for c in recent[-5:]:
        tail.add_row(
            c.started.strftime("%H:%M:%S"),
            Text(c.tag, style=f"bold {c.lane}"),
            Text(human_dur(c.dur), style="green" if c.ok else "red"),
            Text(clip(c.text.replace("\n", " ⏎ "), console.width - 30), style="dim"),
        )
    return Group(header, body, tail)


