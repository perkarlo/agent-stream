class Keyed:
    """Oturum + subagent kimliğinden türeyen ortak alanlar; Cmd ve Note paylaşır."""
    sid: str
    agent: str
    agent_type: str
    sub: bool

    @property
    def key(self) -> str:
        return f"{self.sid}#{self.agent}" if self.agent else self.sid

    @property
    def tag(self) -> str:
        return self.agent[-4:] if self.agent else self.sid[:4]

    @property
    def label(self) -> str:
        return f" ⤷ {self.agent_type or 'subagent'}" if self.sub else ""

    @property
    def lane(self) -> str:
        return lane_of(self.key)


@dataclass
class Note(Keyed):
    """Komut olmayan olay: insan satırı, soru, cevap, tur sonu, özetleme, api hatası, bağlam."""
    kind: str
    sid: str
    cwd: str
    branch: str
    sub: bool
    ts: datetime
    text: str = ""
    agent: str = ""
    agent_type: str = ""
    extra: dict = field(default_factory=dict)

    def as_json(self) -> dict:
        return {
            "event": self.kind,
            "ts": self.ts.isoformat(timespec="seconds"),
            "session": self.sid, "agent": self.agent, "agent_type": self.agent_type,
            "cwd": self.cwd, "branch": self.branch, "subagent": self.sub,
            "text": self.text, **self.extra,
        }


@dataclass
class Cmd(Keyed):
    uid: str
    sid: str
    cwd: str
    branch: str
    sub: bool
    tool: str
    text: str
    desc: str
    started: datetime
    agent: str = ""
    agent_type: str = ""
    ended: datetime | None = None
    out: str = ""
    err: str = ""
    ok: bool = True

    @property
    def dur(self) -> float:
        end = self.ended or datetime.now(tz=self.started.tzinfo)
        return max(0.0, (end - self.started).total_seconds())

    @property
    def body(self) -> list[tuple[str, bool]]:
        """Çıktı satırları: (metin, stderr mi)."""
        return [(l, False) for l in self.out.splitlines()] + [(l, True) for l in self.err.splitlines()]

    def as_json(self) -> dict:
        return {
            "event": "command",
            "ts": self.started.isoformat(timespec="seconds"),
            "session": self.sid,
            "agent": self.agent,
            "agent_type": self.agent_type,
            "cwd": self.cwd,
            "branch": self.branch,
            "subagent": self.sub,
            "tool": self.tool,
            "command": self.text,
            "description": self.desc,
            "duration_ms": round(self.dur * 1000),
            "ok": self.ok,
            "stdout": self.out,
            "stderr": self.err,
        }


class Reader:
    """Eşleşen transcript'leri takip eder; ('start'|'end', Cmd) olayları üretir."""

    def __init__(self, root: Path, project: str | None, session: str | None,
                 all_tools: bool, subagents: bool, stale_min: float, watch: bool = True,
                 tail: int = 0):
        self.root, self.project, self.session = root, project, session
        self.all_tools, self.subagents, self.stale_min = all_tools, subagents, stale_min
        self.tail = tail
        self.offsets: dict[str, int] = {}
        self.open: dict[str, Cmd] = {}
        self.asks: dict[str, Note] = {}
        self.loops: set[str] = set()                       # ScheduleWakeup çağıran oturumlar
        self.bg: dict[str, int] = {}                       # turda başlatılan arka plan işi sayısı
        self.seen_files: set[str] = set()
        self.watcher = make_watcher() if watch else PollWatcher()
        self.rescan = SAFETY_RESCAN if self.watcher.name == "poll" else EVENT_RESCAN
        self._paths: list[str] = []
        self._dirs: list[str] = []
        self._scanned = 0.0
        self._need_scan = True
        self._idle = 0

    # -- dosya keşfi
    def _walk(self) -> tuple[list[str], list[str]]:
        """scandir ile yürür; taze olmayan proje dizinlerine hiç inmez (glob'un üçte biri)."""
        now = time.time()
        files: list[str] = []
        dirs: list[str] = [str(self.root)]
        try:
            projects = list(os.scandir(self.root))
        except OSError:
            return [], dirs
        for proj in projects:
            if not proj.is_dir():
                continue
            if self.project and self.project.lower() not in proj.path.lower():
                continue
            try:
                if now - proj.stat().st_mtime > FRESH:
                    continue
            except OSError:
                continue
            dirs.append(proj.path)
            stack = [proj.path]
            while stack:
                cur = stack.pop()
                try:
                    entries = list(os.scandir(cur))
                except OSError:
                    continue
                for e in entries:
                    if e.is_dir(follow_symlinks=False):
                        if self.subagents:                 # subagent'lar <oturum>/subagents/ altında
                            dirs.append(e.path)
                            stack.append(e.path)
                    elif e.name.endswith(".jsonl"):
                        files.append(e.path)
        return files, dirs

    def scan(self) -> None:
        self._paths, self._dirs = self._walk()
        self._scanned = time.time()
        self._need_scan = False
        self.watcher.sync(self._dirs, self.seen_files)

    def files(self) -> Iterable[tuple[str, os.stat_result]]:
        now = time.time()
        full = self._need_scan or now - self._scanned > self.rescan
        if full:
            self.scan()
        # Ara turlarda yalnız takip edilenlere bakılır; yenisi taramada yakalanır.
        for path in (self._paths if full else list(self.seen_files)):
            if self.session and self.session not in path:
                continue
            try:
                st = os.stat(path)
            except OSError:
                continue
            if path not in self.seen_files and now - st.st_mtime > self.stale_min * 60:
                continue
            yield path, st

    def wanted(self, tool: str) -> bool:
        return tool != "TodoWrite" if self.all_tools else tool == "Bash"

    # -- ayrıştırma
    def _summary(self, tool: str, inp: dict) -> str:
        if tool == "Bash":
            return str(inp.get("command", ""))
        arg = inp.get("file_path") or inp.get("pattern") or inp.get("url") or inp.get("skill") \
            or inp.get("query") or inp.get("command") or inp.get("prompt") \
            or json.dumps(inp, ensure_ascii=False)
        return f"{pretty_tool(tool)} {clip(str(arg).replace(chr(10), ' '), 160)}"

    def _result(self, entry: dict, block: dict) -> tuple[str, str, bool]:
        tur = entry.get("toolUseResult")
        # stdout/stderr yalnız Bash'te var; diğer araçlarda çıktı tool_result bloğunda.
        if isinstance(tur, dict) and ("stdout" in tur or "stderr" in tur):
            o, e = clean(tur.get("stdout", "")), clean(tur.get("stderr", ""))
            if tur.get("interrupted"):
                return o, (e + "\n[kesildi]").strip(), False
            return o, e, not block.get("is_error", False)
        content = block.get("content")
        if isinstance(content, list):
            content = "\n".join(b.get("text", "") for b in content if isinstance(b, dict))
        text = clean(content if isinstance(content, str) else "")
        if not text and isinstance(tur, dict):             # ToolSearch/MCP: metin yok, yapı var
            text = clean(json.dumps(tur, ensure_ascii=False, indent=1)[:2000])
        return ("", text, False) if block.get("is_error") else (text, "", True)

    def _note(self, entry: dict, kind: str, text: str = "", **extra) -> Note:
        sub = bool(entry.get("isSidechain")) or bool(entry.get("agentId"))
        return Note(kind=kind, sid=entry.get("sessionId", "????"), cwd=entry.get("cwd", ""),
                    branch=entry.get("gitBranch", ""), sub=sub, ts=parse_ts(entry.get("timestamp")),
                    text=text, agent=str(entry.get("agentId", "")),
                    agent_type=str(entry.get("attributionAgent", "")), extra=extra)

    def _prompt(self, content: str) -> str:
        """`<command-name>/tur</command-name>` sarmalını `/tur args` biçimine indirir."""
        m = re.search(r"<command-name>(.*?)</command-name>", content, re.S)
        if not m:
            return clean(content).strip()
        args = re.search(r"<command-args>(.*?)</command-args>", content, re.S)
        return (m.group(1).strip() + " " + (args.group(1).strip() if args else "")).strip()

    def _side(self, entry: dict) -> Iterable[tuple[str, Note]]:
        """Komut dışı olaylar: insan satırı, tur sonu, bağlam, özetleme, api hatası."""
        typ = entry.get("type")
        msg = entry.get("message") or {}
        sub = bool(entry.get("isSidechain")) or bool(entry.get("agentId"))
        if sub and not self.subagents:
            return
        if typ == "user":
            content = msg.get("content")
            if entry.get("isCompactSummary"):
                yield "compact", self._note(entry, "compact", "bağlam özetlendi")
            elif isinstance(content, str) and not entry.get("isMeta"):
                origin = (entry.get("origin") or {}).get("kind")
                if origin == "human" or (origin is None and "<command-message>" not in content):
                    yield "human", self._note(entry, "human", self._prompt(content))
                elif origin is None:                       # origin'siz slash = /loop ya da cron ateşlemesi
                    note = self._note(entry, "fire", self._prompt(content))
                    self.loops.add(note.key)
                    yield "fire", note
                elif origin == "task-notification":        # arka plan işi bitti, oturum uyandı
                    first = next((l for l in clean(content).splitlines() if l.strip()), "")
                    note = self._note(entry, "fire", clip(unmark(first), 80), task=True)
                    self.bg[note.key] = max(0, self.bg.get(note.key, 0) - 1)
                    yield "fire", note
        elif typ == "assistant":
            usage = msg.get("usage") or {}
            tokens = sum(int(usage.get(k) or 0) for k in
                         ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
            if tokens:
                yield "ctx", self._note(entry, "ctx", tokens=tokens, model=str(msg.get("model", "")))
            if msg.get("stop_reason") == "end_turn" and not sub:
                text = " ".join(b.get("text", "") for b in msg.get("content") or []
                                if isinstance(b, dict) and b.get("type") == "text")
                first = next((l for l in clean(text).splitlines() if l.strip()), "")
                if not first:                              # aynı yanıt birkaç satıra bölünür; metinli olan tek
                    return
                key = self._note(entry, "turn").key
                loop = key in self.loops                   # /loop uyanmayı bekliyor, seni değil
                self.loops.discard(key)
                bg = self.bg.get(key, 0)                   # arka plan işi turlar boyu sürer, bildirimle düşer
                yield "turn", self._note(entry, "turn", unmark(first), loop=loop, bg=bg)
        elif typ == "system":
            if entry.get("subtype") == "api_error":
                err = entry.get("error") or {}
                yield "apierr", self._note(entry, "apierr", str(err.get("formatted") or err.get("message") or "api hatası"))
            elif entry.get("subtype") == "compact_boundary":
                yield "compact", self._note(entry, "compact", "bağlam özetlendi")

    def _ask(self, entry: dict, block: dict) -> Note:
        inp = block.get("input") or {}
        qs = inp.get("questions") or []
        q = qs[0] if qs and isinstance(qs[0], dict) else {}
        opts = [str(o.get("label", "")) for o in q.get("options") or [] if isinstance(o, dict)]
        text = str(q.get("header") or ASKS.get(block.get("name", ""), "soru"))
        return self._note(entry, "ask", text, question=clean(str(q.get("question", ""))),
                          options=opts, tool=block.get("name", ""))

    def _answer(self, entry: dict, block: dict, ask: Note) -> Note:
        tur = entry.get("toolUseResult")
        answers = tur.get("answers") if isinstance(tur, dict) else None
        text = " · ".join(str(v) for v in answers.values()) if isinstance(answers, dict) and answers \
            else ("reddedildi" if block.get("is_error") else "cevaplandı")
        return self._note(entry, "answer", clean(text), header=ask.text, tool=ask.extra.get("tool", ""))

    def _events(self, entry: dict) -> Iterable[tuple[str, Cmd | Note]]:
        yield from self._side(entry)
        content = (entry.get("message") or {}).get("content")
        if not isinstance(content, list):
            return
        for block in content:
            if not isinstance(block, dict):
                continue
            kind = block.get("type")
            if kind == "tool_use" and block.get("name") in ASKS:
                note = self._ask(entry, block)
                self.asks[block.get("id", "")] = note
                yield "ask", note
            elif kind == "tool_result" and block.get("tool_use_id", "") in self.asks:
                ask = self.asks.pop(block.get("tool_use_id", ""))
                yield "answer", self._answer(entry, block, ask)
            elif kind == "tool_use":
                tool = block.get("name", "")
                if tool in ("ScheduleWakeup", "CronCreate"):
                    self.loops.add(self._note(entry, "ctx").key)
                inp_ = block.get("input") or {}
                if tool == "Monitor" or inp_.get("run_in_background") is True:
                    k = self._note(entry, "ctx").key
                    self.bg[k] = self.bg.get(k, 0) + 1
                elif tool == "TaskStop":
                    k = self._note(entry, "ctx").key
                    self.bg[k] = max(0, self.bg.get(k, 0) - 1)
                if not self.wanted(tool):
                    continue
                sub = bool(entry.get("isSidechain")) or bool(entry.get("agentId"))
                if sub and not self.subagents:
                    continue
                inp = block.get("input") or {}
                cmd = Cmd(
                    uid=block.get("id", ""), sid=entry.get("sessionId", "????"),
                    cwd=entry.get("cwd", ""), branch=entry.get("gitBranch", ""), sub=sub,
                    agent=str(entry.get("agentId", "")),
                    agent_type=str(entry.get("attributionAgent", "")),
                    tool=tool, text=self._summary(tool, inp),
                    desc=str(inp.get("description", "")),
                    started=parse_ts(entry.get("timestamp")),
                )
                self.open[cmd.uid] = cmd
                yield "start", cmd
            elif kind == "tool_result":
                cmd = self.open.pop(block.get("tool_use_id", ""), None)
                if not cmd:
                    continue
                cmd.out, cmd.err, cmd.ok = self._result(entry, block)
                cmd.ended = parse_ts(entry.get("timestamp"))
                yield "end", cmd

    # -- okuma turu
    def poll(self, first: bool = False, backfill: int = 0) -> list[tuple[str, Cmd | Note]]:
        events: list[tuple[str, Cmd | Note]] = []
        fresh_file = False
        for path, st in self.files():
            mid = False
            if path not in self.seen_files:
                self.seen_files.add(path)
                fresh_file = True
                # Yeni dosya akışa sonundan katılır; geriye dönük okuma yalnız --backfill ile.
                self.offsets[path] = 0 if (first and backfill) else st.st_size
                if first and self.tail:                    # durum kurmak için yalnız kuyruk
                    self.offsets[path] = max(0, st.st_size - self.tail)
                    mid = self.offsets[path] > 0
            if st.st_size < self.offsets[path]:            # kırpılmış / döndürülmüş
                self.offsets[path] = 0
            if st.st_size == self.offsets[path]:
                continue
            try:
                with open(path, "rb") as fh:
                    fh.seek(self.offsets[path])
                    raw = fh.read()
                    self.offsets[path] = fh.tell()
            except OSError:
                continue
            if mid:                                        # kuyruğun ilk satırı yarım, atılır
                raw = raw.split(b"\n", 1)[1] if b"\n" in raw else b""
            lines = raw.decode("utf-8", errors="replace").splitlines()
            if first and backfill:
                lines = lines[-backfill * 6:]
            for line in lines:
                if not any(m in line for m in MARKS):
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                events.extend(self._events(entry))
        if fresh_file:
            self.watcher.sync(self._dirs, self.seen_files)
        if first and backfill:
            starts = [e for e in events if e[0] == "start"]
            keep = {c.uid for _, c in starts[-backfill:]}
            events = [(k, c) for k, c in events if isinstance(c, Note) or c.uid in keep]
        self._idle = 0 if events else min(self._idle + 1, len(IDLE_STEPS) - 1)
        return events

    def wait(self, base: float = 0.25) -> None:
        """Olay arka ucunda çekirdek uyandırır; yoklamada boşta kaldıkça aralık büyür."""
        timeout = self.rescan if self.watcher.name != "poll" else max(base, IDLE_STEPS[self._idle])
        _, rescan = self.watcher.wait(timeout)
        if rescan:
            self._need_scan = True

    def close(self) -> None:
        self.watcher.close()


