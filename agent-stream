def load_config() -> dict:
    if not CONFIG_PATH.exists():
        return {}
    try:
        with open(CONFIG_PATH, "rb") as fh:
            return tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError) as exc:
        err_console.print(f"[yellow]uyarı:[/] {CONFIG_PATH} okunamadı ({exc}); yok sayıldı", highlight=False)
        return {}


def merged_config(section: str) -> dict:
    """`[genel]` + alt komutun kendi bölümü; alt komut bölümü üstte."""
    raw = load_config()
    return {**raw.get("genel", {}), **raw.get(section, {})}


def pick(cli, cfg: dict, key: str, fallback, cast=None):
    """Öncelik: bayrak > ortam değişkeni > ayar dosyası > varsayılan (clig.dev)."""
    if cli is not None:
        return cli
    env = os.environ.get(f"AGENT_STREAM_{key.upper()}")
    if env is not None:
        return cast(env) if cast else env
    if key in cfg:
        return cfg[key]
    return fallback


def setup_console(no_color: bool) -> Console:
    if no_color or os.environ.get("NO_COLOR") or os.environ.get("TERM") == "dumb":
        return Console(no_color=True, highlight=False, soft_wrap=False)
    return Console(highlight=False, soft_wrap=False)


def set_theme(name: str) -> None:
    """Tema adını doğrular ve modül düzeyinde sabitler."""
    global THEME
    if name not in ("ansi_dark", "ansi_light"):
        try:
            from pygments.styles import get_style_by_name
            get_style_by_name(name)
        except Exception:
            die(f"bilinmeyen tema: {name}",
                "monokai · dracula · nord · github-dark · gruvbox-dark · ansi_dark", EXIT_USAGE)
    THEME = name
    _HL.clear()


