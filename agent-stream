IDLE_STEPS = (0.25, 0.5, 1.0, 2.0)  # yoklama arka ucunun geri çekilme merdiveni
WATCH_CAP = 512                     # izlenecek fd üst sınırı

THEME = "monokai"                   # komut bloğunun renk teması; --theme ile değişir

