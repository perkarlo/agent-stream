def die(msg: str, hint: str = "", code: int = EXIT_ERR) -> None:
    err_console.print(f"[bold red]hata:[/] {msg}", highlight=False)
    if hint:
        err_console.print(f"      {hint}", style="dim", highlight=False)
    raise SystemExit(code)


def lane_of(sid: str) -> str:
    return LANES[sum(sid.encode()) % len(LANES)]


def pretty_project(name: str) -> str:
    """`-Users-ben-Documents-myapp` → `myapp`; ev dizininin kendisi → `~`."""
    home = str(HOME).replace("/", "-")
    if name == home:
        return "~"
    name = name.removeprefix(f"{home}-Documents-").removeprefix(f"{home}-") or "~"
    if "--claude-worktrees-" in name:                      # myapp--claude-worktrees-x-3def31 → myapp⎇x
        base, wt = name.split("--claude-worktrees-", 1)
        return f"{base}⎇{wt.rsplit('-', 1)[0]}"
    return name


def pretty_tool(name: str) -> str:
    """`mcp__trello__trello_list_cards` → `trello:list_cards`; uuid sunucular `mcp:` olur."""
    if not name.startswith("mcp__"):
        return name
    parts = name.split("__")
    server, tool = (parts[1], parts[-1]) if len(parts) > 2 else (parts[-1], parts[-1])
    server = "mcp" if UUID.fullmatch(server) else server
    return f"{server}:{tool.removeprefix(server + '_')}"


def glyph_of(tool: str) -> str:
    return "⚙" if tool.startswith("mcp__") else GLYPH.get(tool, "·")


def short_path(p: str) -> str:
    if not p:
        return "?"
    p = p.replace(str(HOME), "~")
    parts = p.rstrip("/").split("/")
    return "/".join(parts[-2:]) if len(parts) > 2 else p


def clean(text: str | None) -> str:
    """Çıktıdan system-reminder bloklarını, ANSI dizilerini ve kontrol baytlarını atar."""
    text = SYSREM.sub("", text or "")
    return CTRL.sub("", ANSI.sub("", text)).rstrip()


MD = re.compile(r"\*\*|__|`|^#+\s*|^[-*]\s+")


def unmark(text: str) -> str:
    """Tur özetinden markdown vurgusunu ayıklar: `**Hot fix indi:**` → `Hot fix indi:`."""
    return MD.sub("", text).strip()


def clip(s: str, n: int) -> str:
    """Terminal hücresiyle ölçer: emoji ve CJK karakterler iki hücre yer kaplar."""
    return s if cell_len(s) <= n else set_cell_size(s, max(1, n - 1)) + "…"


def parse_ts(iso: str | None) -> datetime:
    if not iso:
        return datetime.now()
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return datetime.now()


def pretty_model(name: str) -> str:
    """`claude-opus-5` → `opus 5`; `claude-haiku-4-5-20251001` → `haiku 4.5`."""
    parts = name.removeprefix("claude-").split("-")
    fam = parts[0] if parts else name
    ver = ".".join(x for x in parts[1:] if x.isdigit() and len(x) < 3)
    return f"{fam} {ver}".strip()


def human_tok(n: int) -> str:
    return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n // 1000}k" if n >= 1000 else str(n)


def ctx_bar(tokens: int, window: int, cells: int = 5) -> Text:
    """`▮▮▮▯▯ 674k`; %80 üstü kırmızı, %60 üstü sarı."""
    ratio = min(1.0, tokens / max(1, window))
    full = round(ratio * cells)
    style = "red" if ratio >= 0.8 else "yellow" if ratio >= 0.6 else "dim"
    t = Text("▮" * full + "▯" * (cells - full), style=style)
    t.append(f" {human_tok(tokens)}", style="dim")
    return t


def ring() -> None:
    """Terminal zili; stdout veri kanalı olduğu için stderr'e yazılır."""
    try:
        sys.stderr.write("\a")
        sys.stderr.flush()
    except OSError:
        pass


def short_dur(sec: float) -> str:
    """Bekleme süresi için kısa biçim: `42s` · `3dk` · `1sa 9dk`."""
    if sec < 60:
        return f"{sec:.0f}s"
    if sec < 3600:
        return f"{int(sec // 60)}dk"
    return f"{int(sec // 3600)}sa {int(sec % 3600 // 60)}dk"


def human_dur(sec: float) -> str:
    if sec < 1:
        return f"{sec * 1000:.0f}ms"
    if sec < 60:
        return f"{sec:.1f}s"
    return f"{int(sec // 60)}dk {int(sec % 60)}s"


_HL: dict[tuple[str, str], Text] = {}


def highlight(code: str) -> Text:
    """Boyanmış komut metni; panoda kare başına yeniden boyamak 0,55 ms tutuyordu."""
    key = (code, THEME)
    hit = _HL.get(key)
    if hit is None:
        from rich.syntax import Syntax                     # pygments yalnız renkli yolda
        hit = Syntax(code, "bash", theme=THEME, background_color="default").highlight(code)
        hit.rstrip()
        if len(_HL) > 256:
            _HL.clear()
        _HL[key] = hit
    return hit.copy()


