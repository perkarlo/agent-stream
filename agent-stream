def add_common(ap: argparse.ArgumentParser, dash: bool = False) -> None:
    ap.add_argument("-p", "--project", metavar="AD", help="proje/cwd filtresi (parça eşleşmesi)")
    ap.add_argument("-s", "--session", metavar="ETİKET", help="oturum etiketi öneki, örn. a3d1")
    ap.add_argument("-a", "--all-tools", dest="all_tools", action="store_true", default=None,
                    help="tüm araçlar (varsayılan)")
    ap.add_argument("-B", "--bash-only", dest="all_tools", action="store_false",
                    help="yalnız Bash komutları")
    ap.add_argument("-m", "--max-cmd", type=int, metavar="N",
                    help="komut bloğu satır sınırı (0 = sınırsız)")
    ap.add_argument("--stale", type=float, metavar="DK", help="bu süredir sessiz oturumlar atlanır")
    ap.add_argument("--interval", type=float, metavar="SN", help="yoklama arka ucunun taban aralığı")
    ap.add_argument("--theme", metavar="AD", help="komut bloğu teması (monokai, nord, ansi_dark…)")
    ap.add_argument("--root", metavar="DİZİN", help="transcript kökü")
    if not dash:
        ap.add_argument("--subagents", dest="subagents", action="store_true", default=None,
                        help="subagent şeritlerini göster (varsayılan)")
        ap.add_argument("--no-subagents", dest="subagents", action="store_false",
                        help="subagent'ları gizle")


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="agent-stream", add_help=True,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Claude Code oturumlarının çalıştırdığı komutları canlı akıtır.\n\n" + EXAMPLES,
    )
    ap.add_argument("-V", "--version", action="version", version=f"agent-stream {VERSION}")
    add_common(ap)
    ap.add_argument("-q", "--quiet", action="store_true", help="sadece komutlar, çıktı yok")
    ap.add_argument("-n", "--max-lines", type=int, metavar="N", help="komut başına çıktı satırı sınırı")
    ap.add_argument("-b", "--backfill", type=int, metavar="N", help="açılışta son N komutu da göster")
    ap.add_argument("--pair", action="store_true", help="komutu çıktısıyla birlikte, bittiğinde yaz")
    ap.add_argument("--no-desc", dest="desc", action="store_false", help="komut açıklamasını gizle")
    ap.add_argument("--json", dest="as_json", action="store_true", help="satır satır JSON (NDJSON) yaz")
    ap.add_argument("--no-color", action="store_true", help="rengi kapat (NO_COLOR da geçerli)")

    subs = ap.add_subparsers(dest="cmd")

    p_stream = subs.add_parser("stream", formatter_class=argparse.RawDescriptionHelpFormatter,
                               help="komutları ve çıktılarını akış halinde yaz (varsayılan görünüm)")
    add_common(p_stream)
    p_stream.add_argument("-q", "--quiet", action="store_true")
    p_stream.add_argument("-n", "--max-lines", type=int, metavar="N")
    p_stream.add_argument("-b", "--backfill", type=int, metavar="N")
    p_stream.add_argument("--pair", action="store_true")
    p_stream.add_argument("--no-desc", dest="desc", action="store_false")
    p_stream.add_argument("--json", dest="as_json", action="store_true")
    p_stream.add_argument("--no-color", action="store_true")

    p_dash = subs.add_parser("dash", help="paralel oturumları yan yana şeritlerde gösteren canlı pano")
    add_common(p_dash, dash=True)
    p_dash.add_argument("-c", "--columns", dest="lanes", type=int, metavar="N",
                        help="yan yana gösterilecek oturum sayısı")

    p_ses = subs.add_parser("sessions", help="aktif oturumları etiketleriyle listele")
    p_ses.add_argument("--stale", type=float, metavar="DK", default=60)
    p_ses.add_argument("--all", dest="all_", action="store_true", help="süre filtresi olmadan hepsi")
    p_ses.add_argument("--json", dest="as_json", action="store_true")
    p_ses.add_argument("--root", metavar="DİZİN")

    p_rep = subs.add_parser("replay", help="geçmiş bir oturumun komutlarını baştan yaz")
    p_rep.add_argument("tag", help="oturum etiketi ya da tam id")
    p_rep.add_argument("-n", "--max-lines", type=int, metavar="N")
    p_rep.add_argument("-m", "--max-cmd", type=int, metavar="N")
    p_rep.add_argument("-a", "--all-tools", dest="all_tools", action="store_true", default=None)
    p_rep.add_argument("-B", "--bash-only", dest="all_tools", action="store_false")
    p_rep.add_argument("--theme", metavar="AD")
    p_rep.add_argument("--no-color", action="store_true")
    p_rep.add_argument("--root", metavar="DİZİN")
    return ap


def root_of(args) -> Path:
    return Path(getattr(args, "root", None) or DEFAULT_ROOT).expanduser()


def cmd_stream(args) -> None:
    cfg = merged_config("stream")
    max_lines = int(pick(args.max_lines, cfg, "max_lines", 12, int))
    max_cmd = int(pick(args.max_cmd, cfg, "max_cmd", 6, int))
    stale = float(pick(args.stale, cfg, "stale", 30, float))
    base = float(pick(args.interval, cfg, "interval", 0.25, float))
    project = pick(args.project, cfg, "project", None)
    all_tools = pick(args.all_tools, cfg, "all_tools", True)
    subagents = args.subagents if args.subagents is not None else cfg.get("subagents", True)
    set_theme(str(pick(args.theme, cfg, "theme", "monokai")))
    root = root_of(args)
    if not root.is_dir():
        die(f"{root} yok", "Claude Code bu makinede hiç çalışmamış olabilir; --root ile başka bir kök verebilirsin.")

    console = setup_console(args.no_color)
    reader = Reader(root, project, args.session, all_tools, subagents, stale)
    view = StreamView(console, max_lines, args.desc, not args.quiet, max_cmd)
    backfill = int(pick(args.backfill, cfg, "backfill", 0, int))

    if not args.as_json:
        err_console.print(f"[dim]agent-stream {VERSION} · {project or 'tüm projeler'} · "
                          f"{reader.watcher.name} · çıkış Ctrl+C[/]", highlight=False)
    try:
        events = reader.poll(first=True, backfill=backfill)
        while True:
            for kind, cmd in events:
                if args.as_json:
                    if kind == "end":
                        print(json.dumps(cmd.as_json(), ensure_ascii=False), flush=True)
                elif kind == "start":
                    if not args.pair:
                        view.start(cmd)
                else:
                    if args.pair:
                        view.start(cmd)
                    view.end(cmd)
            reader.wait(base)
            events = reader.poll()
    finally:
        reader.close()


def cmd_dash(args) -> None:
    from rich.live import Live
    cfg = merged_config("dash")
    stale = float(pick(args.stale, cfg, "stale", 15, float))
    max_cmd = int(pick(args.max_cmd, cfg, "max_cmd", 4, int))
    cols = int(pick(args.lanes, cfg, "columns", 4, int))
    base = float(pick(args.interval, cfg, "interval", 0.25, float))
    project = pick(args.project, cfg, "project", None)
    all_tools = pick(args.all_tools, cfg, "all_tools", True)
    set_theme(str(pick(args.theme, cfg, "theme", "monokai")))
    root = root_of(args)
    if not root.is_dir():
        die(f"{root} yok", "--root ile transcript kökünü verebilirsin.")
    console = setup_console(False)
    if not console.is_terminal:
        die("pano bir terminal gerektirir", "boru hattında `agent-stream --json` kullan.", EXIT_USAGE)

    reader = Reader(root, project, args.session, all_tools, True, stale)
    lanes: dict[str, Lane] = {}
    recent: list[Cmd] = []
    started, total, drawn = time.time(), 0, 0.0

    reader.poll(first=True)
    try:
        # Kare yalnız durum değişince üretilir; koşan komut varken spinner için 4 fps.
        with Live(console=console, screen=True, auto_refresh=False, transient=True) as live:
            while True:
                changed = False
                for kind, cmd in reader.poll():
                    lane = lanes.setdefault(cmd.key, Lane(cmd.key))
                    lane.tag, lane.label = cmd.tag, cmd.label
                    lane.cwd, lane.branch, lane.seen = cmd.cwd, cmd.branch, time.time()
                    if kind == "start":
                        lane.running, total, changed = cmd, total + 1, True
                    else:
                        lane.running, lane.last, lane.count = None, cmd, lane.count + 1
                        recent.append(cmd)
                        recent[:] = recent[-20:]
                        changed = True
                cutoff = time.time() - stale * 60
                for key in [k for k, l in lanes.items() if l.seen < cutoff]:
                    del lanes[key]
                    changed = True

                running = any(l.running for l in lanes.values())
                now = time.time()
                if changed or (running and now - drawn >= 0.25) or now - drawn >= 5.0:
                    live.update(dash_frame(lanes, recent, started, total, console, cols, max_cmd),
                                refresh=True)
                    drawn = now
                reader.wait(base if running else 1.0)
    finally:
        reader.close()


def cmd_sessions(args) -> None:
    from rich.table import Table
    cfg = merged_config("sessions")
    stale = float(pick(None if args.stale == 60 else args.stale, cfg, "stale", 60, float))
    root = root_of(args)
    if not root.is_dir():
        die(f"{root} yok")
    rows = []
    for path in glob.glob(str(root / "*" / "*.jsonl")):
        st = os.stat(path)
        age = (time.time() - st.st_mtime) / 60
        if not args.all_ and age > stale:
            continue
        rows.append({
            "session": os.path.basename(path)[:-6],
            "tag": os.path.basename(path)[:4],
            "project": os.path.basename(os.path.dirname(path)),
            "idle_min": round(age, 1),
            "size_kb": round(st.st_size / 1024),
        })
    rows.sort(key=lambda r: r["idle_min"])

    if args.as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=2), flush=True)
        return
    if not rows:
        err_console.print(f"[dim]son {stale:g} dakikada aktif oturum yok (--all ile hepsini gör)[/]")
        return
    table = Table(box=None, pad_edge=False, header_style="dim")
    table.add_column("etiket")
    table.add_column("proje")
    table.add_column("boş", justify="right")
    table.add_column("boyut", justify="right")
    for r in rows[:40]:
        table.add_row(
            Text(r["tag"], style=f"bold {lane_of(r['session'])}"),
            pretty_project(r["project"]),
            f"{r['idle_min']:.0f} dk", f"{r['size_kb']} KB",
        )
    out_console.print(table)


def cmd_replay(args) -> None:
    cfg = merged_config("replay")
    max_lines = int(pick(args.max_lines, cfg, "max_lines", 6, int))
    max_cmd = int(pick(args.max_cmd, cfg, "max_cmd", 10, int))
    all_tools = pick(args.all_tools, cfg, "all_tools", True)
    set_theme(str(pick(args.theme, cfg, "theme", "monokai")))
    root = root_of(args)
    matches = [p for p in glob.glob(str(root / "**" / "*.jsonl"), recursive=True)
               if os.path.basename(p).startswith(args.tag)]
    if not matches:
        die(f"'{args.tag}' ile başlayan oturum yok",
            "agent-stream sessions --all ile etiketlere bakabilirsin.")
    if len(matches) > 1:
        die(f"'{args.tag}' birden çok oturumla eşleşti",
            "daha uzun bir önek ver: " + ", ".join(os.path.basename(m)[:8] for m in matches[:5]))

    console = setup_console(args.no_color)
    reader = Reader(root, None, None, all_tools, True, stale_min=float("inf"), watch=False)
    reader.seen_files.add(matches[0])
    reader.offsets[matches[0]] = 0
    reader._paths = [matches[0]]
    reader._scanned = time.time()
    reader._need_scan = False
    view = StreamView(console, max_lines, True, True, max_cmd)
    for kind, cmd in reader.poll():
        if kind == "end":          # oynatma canlı değil: komut çıktısıyla bitişik kalsın
            view.start(cmd)
            view.end(cmd)


def main(argv: list[str] | None = None) -> None:
    args = build_parser().parse_args(argv)
    {"dash": cmd_dash, "sessions": cmd_sessions, "replay": cmd_replay}.get(
        getattr(args, "cmd", None) or "stream", cmd_stream)(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        err_console.print("\n[dim]durduruldu[/]")
        sys.exit(EXIT_SIGINT)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(EXIT_OK)
