def lan_ip() -> str:
    """Ev ağındaki adres; UDP soketi bağlanmaz, yalnız yönlendirme tablosuna bakar."""
    import socket
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.connect(("10.255.255.255", 1))
            return sock.getsockname()[0]
    except OSError:
        return "127.0.0.1"


class WebSink:
    """Akışı HTML parçaları olarak SSE ile yayınlar; rastgele yol dışında hiçbir şey vermez."""

    def __init__(self, port: int, max_lines: int, show_desc: bool, show_output: bool, max_cmd: int):
        import io
        import secrets
        import threading
        from collections import deque
        from http.server import ThreadingHTTPServer
        self.token = secrets.token_urlsafe(9)
        self.lock = threading.Lock()
        self.clients: list = []
        self.ring: deque = deque(maxlen=WEB_RING)
        self.state = ""
        self.lanes: dict[str, Lane] = {}
        self.rec = Console(record=True, file=io.StringIO(), width=WEB_WIDTH, force_terminal=True,
                           color_system="truecolor", highlight=False, soft_wrap=False)
        self.view = StreamView(self.rec, max_lines, show_desc, show_output, max_cmd)
        self.theme = web_theme()
        self.server = ThreadingHTTPServer(("0.0.0.0", port), self._handler())
        self.server.daemon_threads = True
        self.port = self.server.server_address[1]
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    @property
    def url(self) -> str:
        return f"http://{lan_ip()}:{self.port}/k/{self.token}/"

    def announce(self, console: Console) -> None:
        """Adres ve QR stderr'e; stdout veri kanalı."""
        import segno
        console.print(f"[bold]telefon:[/] {self.url}", highlight=False)
        segno.make(self.url, error="l").terminal(out=sys.stderr, compact=True, border=1)

    # -- yayın
    def _emit(self, event: str, payload: str) -> None:
        import queue
        item = (event, json.dumps(payload, ensure_ascii=False))
        with self.lock:
            if event == "message":
                self.ring.append(item)
            else:
                self.state = item[1]
            dead = []
            for q in self.clients:
                try:
                    q.put_nowait(item)
                except queue.Full:
                    dead.append(q)
            for q in dead:
                self.clients.remove(q)

    def _state_html(self) -> str:
        from html import escape
        parts = []
        for l in sorted(self.lanes.values(), key=lambda l: l.order):
            if l.waiting == "ask" and l.ask:
                parts.append(f'<span class="y">? {escape(l.tag)} {escape(l.ask.text)}</span>')
            elif l.waiting == "turn":
                wait = (datetime.now(tz=l.since.tzinfo) - l.since).total_seconds() if l.since else 0
                parts.append(f'<span class="w">■ {escape(l.tag)} {short_dur(wait)}</span>')
            elif l.running:
                parts.append(f'<span class="g">● {escape(l.tag)}</span>')
            elif l.loop:
                parts.append(f'<span class="d">⟳ {escape(l.tag)}</span>')
        return "  ".join(parts)

    def feed(self, kind: str, ev: Cmd | Note) -> None:
        apply(self.lanes, kind, ev)
        if isinstance(ev, Note):
            if kind != "ctx":
                self.view.note(ev)
        elif kind == "start":
            self.view.start(ev)
        else:
            self.view.end(ev)
        html = self.rec.export_html(theme=self.theme, clear=True, code_format="{code}", inline_styles=True)
        self.rec.file.seek(0)
        self.rec.file.truncate()
        if html.strip():
            self._emit("message", html)
        if kind != "ctx":
            self._emit("state", self._state_html())

    # -- http
    def _handler(self):
        import queue
        from http.server import BaseHTTPRequestHandler
        sink = self
        page, events = f"/k/{self.token}/", f"/k/{self.token}/events"

        class H(BaseHTTPRequestHandler):
            def log_message(self, *a):                     # erişim logu stderr'i kirletmesin
                pass

            def do_GET(self):
                if self.path.rstrip("/") + "/" == page:
                    body = WEB_PAGE.encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "text/html; charset=utf-8")
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
                elif self.path == events:
                    self._sse()
                else:
                    self.send_response(204 if self.path == "/favicon.ico" else 404)
                    self.end_headers()

            def _sse(self):
                q: queue.Queue = queue.Queue(maxsize=1000)
                with sink.lock:
                    sink.clients.append(q)
                    backlog = [("state", sink.state)] + list(sink.ring)
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream; charset=utf-8")
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                try:
                    for ev, data in backlog:
                        if data:
                            self.wfile.write(f"event: {ev}\ndata: {data}\n\n".encode())
                    self.wfile.flush()
                    while True:
                        try:
                            ev, data = q.get(timeout=15)
                            self.wfile.write(f"event: {ev}\ndata: {data}\n\n".encode())
                        except queue.Empty:
                            self.wfile.write(b": ping\n\n")
                        self.wfile.flush()
                except (BrokenPipeError, ConnectionResetError, OSError):
                    pass
                finally:
                    with sink.lock:
                        if q in sink.clients:
                            sink.clients.remove(q)

        return H


