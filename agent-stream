def lane_print(console: Console, color: str, renderable: RenderableType, marker: str = " ") -> None:
    """Her satırın başına oturum renginde şerit çubuğu yapıştırarak basar."""
    opts = console.options.update(width=max(20, console.width - 3))
    style = console.get_style(color)
    first, rest = Segment(f"▌{marker} ", style), Segment("▌  ", style)
    for i, line in enumerate(console.render_lines(renderable, opts, pad=False)):
        console.print(Segments([first if i == 0 else rest, *line, Segment("\n")]),
                      end="", highlight=False)


def head_text(cmd: Cmd, desc: bool = True) -> Text:
    t = Text(cmd.started.strftime("%H:%M:%S "), style="dim")
    t.append(cmd.tag, style=f"bold {cmd.lane}")
    t.append(f"  {short_path(cmd.cwd)}", style="dim")
    if cmd.branch and cmd.branch != "HEAD":
        t.append(f"  {cmd.branch}", style="dim italic")
    if cmd.sub:
        t.append(f"  {cmd.label.strip()}", style="dim italic")
    if desc and cmd.desc:
        t.append(f"  · {cmd.desc}", style="italic")
    return t


def cut_cmd(text: str, max_cmd: int) -> str:
    """Heredoc'lu komutlar `max_cmd` satırda kırpılır (0 = sınırsız)."""
    lines = text.splitlines()
    if not max_cmd or len(lines) <= max_cmd:
        return text
    return "\n".join(lines[:max_cmd]) + f"\n… +{len(lines) - max_cmd} satır komut"


def cmd_block(cmd: Cmd, color: bool, max_cmd: int = 0) -> RenderableType:
    text = cut_cmd(cmd.text, max_cmd)
    if cmd.tool != "Bash" or not color:
        return Text(text, style="bold", overflow="fold")
    return highlight(text)


def status_text(cmd: Cmd, prefix: str = "") -> Text:
    n = len(cmd.body)
    mark, style = ("✓", "green") if cmd.ok else ("✗", "red")
    t = Text(prefix, style="dim")
    t.append(mark, style=style)
    t.append(f" {human_dur(cmd.dur)}", style="dim")
    t.append(f" · {n} satır" if n else " · çıktı yok", style="dim")
    return t


class StreamView:
    def __init__(self, console: Console, max_lines: int, show_desc: bool, show_output: bool,
                 max_cmd: int = 6):
        self.c, self.max_lines, self.show_desc, self.show_output = console, max_lines, show_desc, show_output
        self.max_cmd = max_cmd
        self.last_uid = ""

    def start(self, cmd: Cmd) -> None:
        self.c.print()
        self.last_uid = cmd.uid
        lane_print(self.c, cmd.lane, head_text(cmd, self.show_desc))
        color = self.c.is_terminal and not self.c.no_color
        lane_print(self.c, cmd.lane, cmd_block(cmd, color, self.max_cmd), glyph_of(cmd.tool))

    def end(self, cmd: Cmd) -> None:
        # Paralel komutlarda çıktı başka bir başlığın altına düşebilir: yeniden çapala.
        if cmd.uid != self.last_uid:
            anchor = Text("↳ ", style="dim")
            anchor.append(clip(cmd.text.replace("\n", " ⏎ "), self.c.width - 8), style="dim italic")
            lane_print(self.c, cmd.lane, anchor)
        self.last_uid = ""
        if self.show_output:
            lines = cmd.body
            for text, is_err in lines[: self.max_lines]:
                body = Text(clip(text, self.c.width - 6), style="red" if is_err else "dim")
                lane_print(self.c, cmd.lane, body)
            rest = len(lines) - self.max_lines
            if rest > 0:
                lane_print(self.c, cmd.lane, Text(f"… +{rest} satır", style="dim italic"))
        lane_print(self.c, cmd.lane, status_text(cmd, "└ "))
        self.c.file.flush()


# ─── Pano görünümü ──────────────────────────────────────────────────────────

@dataclass
class Lane:
    key: str
    tag: str = "????"
    label: str = ""
    cwd: str = ""
    branch: str = ""
    running: Cmd | None = None
    last: Cmd | None = None
    count: int = 0
    seen: float = field(default_factory=time.time)


def lane_parts(lane: Lane, width: int, max_cmd: int) -> tuple[list[RenderableType], list[Text], int]:
    """Şeridin baş bloğu, çıktı kuyruğu ve baş bloğun kapladığı satır sayısı."""
    from rich.columns import Columns
    from rich.spinner import Spinner
    color = lane_of(lane.key)
    cmd = lane.running or lane.last
    inner = max(10, width - 4)
    head: list[RenderableType] = []
    used = 0

    if not cmd:
        return [Text("bekliyor…", style="dim italic")], [], 1

    # Komut şeritte de satır satır durur; heredoc tek satıra sıkıştırılınca okunmuyordu.
    rows = [clip(l, inner * 2) for l in (cmd.text.splitlines() or [""])[:max_cmd]]
    extra = len(cmd.text.splitlines()) - max_cmd
    text = "\n".join(rows) + (f"\n… +{extra} satır komut" if extra > 0 else "")
    head.append(highlight(text))
    used += sum(-(-cell_len(l) // inner) or 1 for l in text.splitlines())
    if cmd.desc:
        head.append(Text(clip(cmd.desc, inner), style="italic"))
        used += 1
    if lane.running:
        head.append(Columns([Spinner("dots", style=color),
                             Text(human_dur(lane.running.dur), style=color)], padding=(0, 1)))
        used += 1
    tail = [Text(clip(line, inner), style="dim") for line, _ in cmd.body]
    return head, tail, used


def lane_need(parts: tuple[list, list, int]) -> int:
    """Şeridin hiç kırpılmadan isteyeceği panel yüksekliği."""
    _, tail, used = parts
    return used + len(tail) + 3                            # boş satır + iki kenarlık


def lane_panel(lane: Lane, height: int, width: int, parts: tuple[list, list, int]):
    from rich.panel import Panel
    head, tail, used = parts
    room = max(1, height - 3 - used)
    body = Group(*head, Text(""), *tail[-room:])

    color = lane_of(lane.key)
    title = Text(f"▌{lane.tag} ", style=f"bold {color}")
    title.append(short_path(lane.cwd), style="bold")
    if lane.branch and lane.branch != "HEAD":
        title.append(f" · {lane.branch}", style="dim")
    if lane.label:
        title.append(lane.label, style="dim italic")
    return Panel(
        body, title=title, title_align="left",
        subtitle=None if lane.running else (status_text(lane.last) if lane.last else None),
        subtitle_align="right",
        border_style=color if lane.running else "dim",
        height=height, width=width, padding=(0, 1),
    )


def dash_frame(lanes: dict[str, Lane], recent: list[Cmd], started: float,
               total: int, console: Console, cols: int, max_cmd: int = 4) -> RenderableType:
    from rich.columns import Columns
    from rich.panel import Panel
    from rich.table import Table
    active = sorted(lanes.values(), key=lambda l: -l.seen)
    shown, hidden = active[:cols], max(0, len(active) - cols)

    header = Table.grid(expand=True)
    header.add_column(justify="left")
    header.add_column(justify="right")
    left = Text("agent-stream", style="bold")
    left.append("  pano", style="dim")
    right = Text(f"{len(active)} şerit", style="bold")
    if hidden:
        right.append(f" (+{hidden} gizli)", style="dim")
    right.append(f" · {total} komut · ↑{human_dur(time.time() - started)}", style="dim")
    header.add_row(left, right)

    room = max(9, console.height - 4 - min(len(recent), 5))
    width = max(26, console.width // max(1, len(shown) or 1) - 1)
    parts = [lane_parts(l, width, max_cmd) for l in shown]
    height = min(room, max([9] + [lane_need(pt) for pt in parts])) if shown else room
    body = Columns([lane_panel(l, height, width, pt) for l, pt in zip(shown, parts)],
                   equal=True, expand=True) \
        if shown else Panel(Text("aktif oturum yok — Claude Code'da bir komut çalıştır", style="dim italic"),
                            border_style="dim", height=height)

    tail = Table.grid(padding=(0, 1))
    tail.add_column(style="dim", width=8)
    tail.add_column(width=4)
    tail.add_column(width=7, justify="right")
    tail.add_column(overflow="ellipsis", no_wrap=True)
    for c in recent[-5:]:
        tail.add_row(
            c.started.strftime("%H:%M:%S"),
            Text(c.tag, style=f"bold {c.lane}"),
            Text(human_dur(c.dur), style="green" if c.ok else "red"),
            Text(clip(c.text.replace("\n", " ⏎ "), console.width - 30), style="dim"),
        )
    return Group(header, body, tail)


